#!/usr/bin/env bash
# huddle-mic-guard: raise an alert when a Slack huddle has ended but MacWhisper
# has not saved a recording, i.e. it is probably still capturing the room.
#
# Notify-only. It never stops MacWhisper, never touches Slack, and only ever
# reads MacWhisper's database.
set -euo pipefail

# Same bash 4.2+ requirement, and the same reason, as huddle-watch: log() uses
# printf's `%(...)T`, and launchd hands jobs a PATH on which
# `#!/usr/bin/env bash` resolves to macOS's bash 3.2. --install names an
# absolute bash in the plist; this guard is the backstop for everything else.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2))); then
  printf 'Error: %s requires bash 4.2 or newer; running under %s (%s).\n' \
    "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" "${BASH:-unknown}" >&2
  printf 'macOS ships bash 3.2 at /bin/bash. Install a current bash (brew install bash)\n' >&2
  printf 'and re-run; if this came from launchd, re-run --install to refresh the plist.\n' >&2
  exit 1
fi

# Why this exists. MacWhisper notices that a Slack huddle ended, but only
# offers a "Finish Recording" prompt, and that prompt can vanish. Recording
# then carries on: 4 of 22 recordings overran by 13-103 minutes, capturing
# whatever was said in the room afterwards.
#
# The signals, verified against the 2026-09-24 huddle. coreaudiod logs every
# change in a process's microphone use:
#
#   SystemStatusWrapper::PublishRecordingClientInfo: Report client 1215 running: no device: <private>
#
# Slack's client is a "Slack Helper" inside Slack.app; MacWhisper's is
# MacWhisper.app's main binary. That morning Slack went `yes` at 08:01:20
# (with brief yes/no flaps for ~7 s), MacWhisper `yes` at 08:01:23, Slack `no`
# at 08:15:14 -- the real end of the huddle -- and MacWhisper `no` at
# 08:15:50, when the Bluetooth mic died. MacWhisper went on recording from a
# fallback mic until 08:41:16. So MacWhisper's own `no` is NOT evidence that
# it stopped recording, and this script never treats it as such.
#
# The "it stopped" signal is instead a row in MacWhisper's database: see
# FINISHED_QUERY.

DB="${HUDDLE_DB:-$HOME/Library/Application Support/MacWhisper/Database/main.sqlite}"
STATE_FILE="${HUDDLE_GUARD_STATE_FILE:-$HOME/.local/state/huddle-transcribe/mic-guard-state}"
# Role cache for pids seen in coreaudiod's log; see resolve_role.
PID_CACHE="${STATE_FILE}.pids"
LOG_FILE="${HUDDLE_GUARD_LOG_FILE:-$HOME/Library/Logs/huddle-transcribe-mic-guard.log}"
# launchd's own stdout/stderr sink, kept apart from the self-rotated log for
# the reason given in huddle-watch's write_plist.
LAUNCHD_LOG_FILE="${LOG_FILE}.launchd"
# Invoked through variables, never by bare name: `log` is also this script's
# logging function, so a bare `log show` would call the function.
OSLOG_BIN="${HUDDLE_GUARD_LOG_BIN:-/usr/bin/log}"
PS_BIN="${HUDDLE_GUARD_PS_BIN:-ps}"
LABEL="com.smartwatermelon.huddle-transcribe.mic-guard"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
LOG_MAX_BYTES=1048576

# Numeric settings use `-`, not `:-`, as huddle-watch does: only an UNSET
# variable takes the default, and an explicitly empty one is rejected below
# rather than silently becoming the default.
#
# How far back to read coreaudiod's log, in minutes. It must cover the whole
# huddle, because the guard needs both the huddle's start (Slack's `yes`,
# and MacWhisper's) and its end in the same window. A 180-minute read took
# about a second on 2026-09-24.
WINDOW_MINUTES="${HUDDLE_GUARD_WINDOW_MINUTES-240}"
# How long Slack's microphone must have stayed released before the huddle
# counts as over. Slack flaps yes/no for several seconds as a huddle starts,
# and a flap must not read as an ending.
SETTLE_SECONDS="${HUDDLE_GUARD_SETTLE_SECONDS-60}"
# Re-alert this often while no recording has been saved, up to MAX_ALERTS
# alerts per huddle.
REALERT_SECONDS="${HUDDLE_GUARD_REALERT_SECONDS-300}"
MAX_ALERTS="${HUDDLE_GUARD_MAX_ALERTS-3}"
# Ignore a huddle that ended longer ago than this. Without a cap, the
# RunAtLoad run at login or --install would alert on a huddle from hours ago
# whose recording was discarded rather than saved.
MAX_AGE_MINUTES="${HUDDLE_GUARD_MAX_AGE_MINUTES-120}"
# Seconds between launchd runs; read only by --install.
POLL_INTERVAL_SECONDS="${HUDDLE_GUARD_POLL_INTERVAL-30}"
# The current time as epoch seconds. Overridable so the tests can replay a
# real day's log with a fixed "now".
# printf's %(%s)T rather than $EPOCHSECONDS, which is bash 5.0+ and would
# be an unbound variable under `set -u` on the 4.2-4.4 this script accepts.
if [[ -n "${HUDDLE_GUARD_NOW+set}" ]]; then
  NOW="$HUDDLE_GUARD_NOW"
else
  printf -v NOW '%(%s)T' -1
fi

# Every one of these reaches a bash arithmetic context, where an unvalidated
# value can execute code (`x[$(cmd)]`), and some reach SQL or the plist. One
# check before any use closes all of it.
for setting in \
  "HUDDLE_GUARD_WINDOW_MINUTES:$WINDOW_MINUTES:1" \
  "HUDDLE_GUARD_SETTLE_SECONDS:$SETTLE_SECONDS:0" \
  "HUDDLE_GUARD_REALERT_SECONDS:$REALERT_SECONDS:0" \
  "HUDDLE_GUARD_MAX_ALERTS:$MAX_ALERTS:1" \
  "HUDDLE_GUARD_MAX_AGE_MINUTES:$MAX_AGE_MINUTES:1" \
  "HUDDLE_GUARD_POLL_INTERVAL:$POLL_INTERVAL_SECONDS:1" \
  "HUDDLE_GUARD_NOW:$NOW:1"; do
  name="${setting%%:*}"
  rest="${setting#*:}"
  value="${rest%:*}"
  minimum="${rest##*:}"
  if ! [[ "$value" =~ ^[0-9]+$ ]] || ((10#$value < minimum)); then
    echo "Error: $name must be a whole number >= $minimum (got '$value')." >&2
    exit 1
  fi
done
unset setting name rest value minimum
# Strip any leading zeros once, so later arithmetic never reads them as octal.
WINDOW_MINUTES=$((10#$WINDOW_MINUTES))
SETTLE_SECONDS=$((10#$SETTLE_SECONDS))
REALERT_SECONDS=$((10#$REALERT_SECONDS))
MAX_ALERTS=$((10#$MAX_ALERTS))
MAX_AGE_MINUTES=$((10#$MAX_AGE_MINUTES))
POLL_INTERVAL_SECONDS=$((10#$POLL_INTERVAL_SECONDS))
NOW=$((10#$NOW))

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

ONCE=0
DRY_RUN=0
INSTALL=0
UNINSTALL=0
STATUS=0

usage() {
  cat <<'EOF'
Usage: huddle-mic-guard [OPTIONS]

Alerts when a Slack huddle has ended but MacWhisper has not saved a
recording since it started recording that huddle -- that is, when MacWhisper
is probably still recording the room. Notify-only: it never stops anything.

Options:
  --once                Check once and exit. Required for the checking mode.
  --dry-run             Report what a check would do; alerts nothing and
                        writes no state
  --install             Install and load the LaunchAgent
  --uninstall           Unload and remove the LaunchAgent
  --status              Report LaunchAgent, state file, and log status
  -h, --help            Show this help

Environment overrides:
  HUDDLE_DB                     MacWhisper database path
  HUDDLE_GUARD_STATE_FILE       Alert state file
  HUDDLE_GUARD_LOG_FILE         Log file
  HUDDLE_GUARD_WINDOW_MINUTES   Minutes of coreaudiod log to read (default 240)
  HUDDLE_GUARD_SETTLE_SECONDS   Seconds Slack's mic must stay released before
                                the huddle counts as ended (default 60)
  HUDDLE_GUARD_REALERT_SECONDS  Seconds between repeat alerts (default 300)
  HUDDLE_GUARD_MAX_ALERTS       Alerts per ended huddle (default 3)
  HUDDLE_GUARD_MAX_AGE_MINUTES  Ignore huddles that ended longer ago than
                                this (default 120)
  HUDDLE_GUARD_POLL_INTERVAL    Seconds between launchd runs, recorded into
                                the plist by --install (default 30)
  HUDDLE_NO_NOTIFY              Set to any value to suppress the alert
  HUDDLE_NOTIFY_BIN             Use this instead of osascript for the alert
  HUDDLE_GUARD_LOG_BIN          Use this instead of /usr/bin/log (testing)
  HUDDLE_GUARD_PS_BIN           Use this instead of ps (testing)
  HUDDLE_GUARD_NOW              Current time in epoch seconds (testing)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --once)
      ONCE=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --install)
      INSTALL=1
      shift
      ;;
    --uninstall)
      UNINSTALL=1
      shift
      ;;
    --status)
      STATUS=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      echo "Error: unexpected argument '$1' (huddle-mic-guard takes options only)" >&2
      usage >&2
      exit 1
      ;;
  esac
done

# --- logging -----------------------------------------------------------

# Copied from huddle-watch; see the comments there. Never fatal, created
# 0600, rotated at LOG_MAX_BYTES.
log() {
  local ts
  printf -v ts '%(%Y-%m-%d %H:%M:%S)T' -1
  printf '%s  %s\n' "$ts" "$*"
}

log_open() {
  local dir
  dir=$(dirname -- "$LOG_FILE")
  mkdir -p "$dir" 2>/dev/null || return 1
  if [[ ! -e "$LOG_FILE" ]]; then
    (
      umask 077
      : >"$LOG_FILE"
    ) 2>/dev/null || return 1
  fi
  return 0
}

log_to_file() {
  local line size
  line=$(log "$@")
  log_open || return 0
  size=$(wc -c <"$LOG_FILE" 2>/dev/null || echo 0)
  size="${size//[[:space:]]/}"
  [[ "$size" =~ ^[0-9]+$ ]] || size=0
  if ((size + ${#line} > LOG_MAX_BYTES)); then
    mv -f "$LOG_FILE" "${LOG_FILE}.1" 2>/dev/null || true
    log_open || return 0
  fi
  printf '%s\n' "$line" >>"$LOG_FILE" 2>/dev/null || true
}

# --- the alert ---------------------------------------------------------

# A modal `display alert ... as critical`, not a notification: a banner can
# be missed, which is the failure this script exists to cover. It is started
# detached, in a double-forked subshell with its streams closed, so the run
# does not block until someone dismisses it. Under launchd that alone is not
# enough -- launchd kills the job's whole process group when the job exits --
# so the plist sets AbandonProcessGroup; see write_plist.
#
# HUDDLE_NO_NOTIFY and HUDDLE_NOTIFY_BIN are the same switches huddle-watch
# honors, so the test suite's global stub covers this script too.
raise_alert() {
  local title="$1" message="$2"
  [[ -z "${HUDDLE_NO_NOTIFY:-}" ]] || return 0
  local notify_bin="${HUDDLE_NOTIFY_BIN:-osascript}"
  command -v "$notify_bin" >/dev/null 2>&1 || return 0
  # Escape for an AppleScript string literal: backslashes, then quotes.
  local esc_msg="$message" esc_title="$title"
  esc_msg="${esc_msg//\\/\\\\}"
  esc_msg="${esc_msg//\"/\\\"}"
  esc_title="${esc_title//\\/\\\\}"
  esc_title="${esc_title//\"/\\\"}"
  (
    "$notify_bin" -e "display alert \"$esc_title\" message \"$esc_msg\" as critical" \
      </dev/null >/dev/null 2>&1 &
  )
  return 0
}

# --- LaunchAgent -------------------------------------------------------

# Same construction as huddle-watch: jq builds JSON, plutil converts it, and
# ProgramArguments[0] is the absolute bash running --install, so launchd
# never consults the shebang. Differences, each deliberate:
#
#   - No WatchPaths. The trigger is the passage of time after a huddle ends,
#     not a database write, so the timer is the whole mechanism.
#   - AbandonProcessGroup is true. launchd otherwise kills every process in
#     the job's process group when the job exits, which would take the
#     detached alert down with it the moment it appeared.
#   - StartInterval defaults to 30 s. A run is one `log show` plus one
#     SQLite query and exits in about a second, and every minute of delay is
#     another minute of the room being recorded. launchd does not start a
#     job again while a run of it is still going, so no lock is needed.
resolve_interpreter() {
  if [[ -n "${BASH:-}" && -x "$BASH" ]]; then
    printf '%s\n' "$BASH"
    return 0
  fi
  echo "Error: cannot determine the path of the running bash (\$BASH is unset)." >&2
  echo "Refusing to write a LaunchAgent that might name the wrong interpreter." >&2
  return 1
}

write_plist() {
  local json_tmp plist_tmp interp
  interp=$(resolve_interpreter) || return 1
  mkdir -p "$(dirname -- "$PLIST")"
  json_tmp=$(mktemp "${PLIST}.json.XXXXXX")
  # --argjson so StartInterval is a plist <integer>; as a string launchd
  # rejects it at load. POLL_INTERVAL_SECONDS is validated numeric above.
  if ! jq -n \
    --arg label "$LABEL" \
    --arg interp "$interp" \
    --arg prog "$SELF_DIR/huddle-mic-guard" \
    --arg log "$LAUNCHD_LOG_FILE" \
    --argjson interval "$POLL_INTERVAL_SECONDS" \
    '{
      Label: $label,
      ProgramArguments: [$interp, $prog, "--once"],
      StartInterval: $interval,
      RunAtLoad: true,
      AbandonProcessGroup: true,
      StandardOutPath: $log,
      StandardErrorPath: $log
    }' >"$json_tmp"; then
    rm -f "$json_tmp"
    echo "Error: failed to build LaunchAgent definition." >&2
    return 1
  fi
  plist_tmp=$(mktemp "${PLIST}.XXXXXX")
  if ! plutil -convert xml1 -o "$plist_tmp" "$json_tmp"; then
    rm -f "$json_tmp" "$plist_tmp"
    echo "Error: plutil failed to convert the LaunchAgent definition." >&2
    return 1
  fi
  rm -f "$json_tmp"
  mv "$plist_tmp" "$PLIST"
}

do_install() {
  write_plist || exit 1
  mkdir -p "$(dirname -- "$LOG_FILE")"
  local uid
  uid=$(id -u)
  # Boot out first so a reinstall really replaces a loaded job; see
  # huddle-watch's do_install.
  launchctl bootout "gui/$uid/$LABEL" 2>/dev/null || true
  if launchctl bootstrap "gui/$uid" "$PLIST" 2>/dev/null; then
    echo "Loaded LaunchAgent $LABEL"
  elif launchctl load "$PLIST" 2>/dev/null; then
    echo "Loaded LaunchAgent $LABEL (via legacy launchctl load)"
  else
    echo "Warning: wrote $PLIST but could not load it." >&2
    echo "Load it manually: launchctl bootstrap gui/$uid \"$PLIST\"" >&2
    exit 1
  fi
  local install_interp
  install_interp=$(resolve_interpreter) || exit 1
  echo "Interp:    $install_interp (bash $BASH_VERSION)"
  echo "Poll:      every ${POLL_INTERVAL_SECONDS}s"
  echo "Log:       $LOG_FILE"
  echo "State:     $STATE_FILE"
  exit 0
}

do_uninstall() {
  local uid
  uid=$(id -u)
  if launchctl bootout "gui/$uid/$LABEL" 2>/dev/null; then
    echo "Unloaded LaunchAgent $LABEL"
  elif [[ -f "$PLIST" ]] && launchctl unload "$PLIST" 2>/dev/null; then
    echo "Unloaded LaunchAgent $LABEL (via legacy launchctl unload)"
  else
    echo "LaunchAgent $LABEL was not loaded."
  fi
  if [[ -f "$PLIST" ]]; then
    rm -f "$PLIST"
    echo "Removed $PLIST"
  fi
  echo "State file left in place: $STATE_FILE"
  exit 0
}

do_status() {
  local uid
  uid=$(id -u)
  if [[ -f "$PLIST" ]]; then
    echo "Plist:     $PLIST"
  else
    echo "Plist:     (not installed)"
  fi
  if launchctl print "gui/$uid/$LABEL" >/dev/null 2>&1; then
    echo "Loaded:    yes"
  else
    echo "Loaded:    no"
  fi
  echo "Database:  $DB"
  if [[ -f "$PLIST" ]] && command -v plutil >/dev/null 2>&1; then
    local plist_interp plist_interval plist_abandon
    plist_interp=$(plutil -extract ProgramArguments.0 raw -o - "$PLIST" 2>/dev/null || printf '')
    if [[ "$plist_interp" == *bash ]]; then
      echo "Interp:    $plist_interp"
    elif [[ -n "$plist_interp" ]]; then
      echo "Interp:    (none -- plist runs $plist_interp via its shebang)"
      echo "           Repair: $0 --install"
    fi
    plist_interval=$(plutil -extract StartInterval raw -o - "$PLIST" 2>/dev/null || printf '')
    if [[ "$plist_interval" =~ ^[0-9]+$ ]]; then
      echo "Poll:      every ${plist_interval}s"
    else
      echo "Poll:      (none -- the guard never runs on a timer)"
      echo "           Repair: $0 --install"
    fi
    plist_abandon=$(plutil -extract AbandonProcessGroup raw -o - "$PLIST" 2>/dev/null || printf '')
    if [[ "$plist_abandon" != "true" ]]; then
      echo "Alerts:    AbandonProcessGroup is not set; launchd may kill the alert"
      echo "           as soon as it appears. Repair: $0 --install"
    fi
  fi
  if [[ -s "$STATE_FILE" ]]; then
    local s_release s_count s_when
    read -r s_release s_count _ <"$STATE_FILE" || true
    if [[ "$s_release" =~ ^[0-9]+$ && "$s_count" =~ ^[0-9]+$ ]]; then
      printf -v s_when '%(%Y-%m-%d %H:%M:%S)T' "$s_release"
      echo "State:     $STATE_FILE (last alerted huddle ended $s_when; $s_count alert(s))"
    else
      echo "State:     $STATE_FILE (unreadable; the next alert rewrites it)"
    fi
  else
    echo "State:     $STATE_FILE (no alert raised yet)"
  fi
  if [[ -f "$LOG_FILE" ]]; then
    echo "Log:       $LOG_FILE"
  else
    echo "Log:       $LOG_FILE (not yet created)"
  fi
  if [[ -f "$LAUNCHD_LOG_FILE" ]]; then
    echo "launchd:   $LAUNCHD_LOG_FILE"
  fi
  exit 0
}

# LaunchAgent management runs before any dependency check.
if [[ $UNINSTALL -eq 1 ]]; then
  do_uninstall
fi
if [[ $STATUS -eq 1 ]]; then
  do_status
fi
if [[ $INSTALL -eq 1 ]]; then
  do_install
fi

if [[ $ONCE -ne 1 && $DRY_RUN -ne 1 ]]; then
  echo "Error: --once is required to run a check." >&2
  echo "Use --dry-run to see what a check would do." >&2
  usage >&2
  exit 1
fi

# --- dependency checks -------------------------------------------------

for dep in sqlite3 "$OSLOG_BIN" "$PS_BIN"; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    echo "Error: required command '$dep' not found." >&2
    exit 1
  fi
done

if [[ ! -r "$DB" ]]; then
  echo "Error: MacWhisper database not readable at $DB" >&2
  exit 1
fi

# --- time --------------------------------------------------------------

# Epoch seconds for a civil date and time at a UTC offset, in pure bash
# arithmetic. date(1) is avoided repo-wide (`date -j` is BSD-only, `date -d`
# GNU-only). This is Howard Hinnant's days_from_civil; every input has
# already been matched as digits, and 10# keeps `08` and `09` from being
# read as invalid octal.
to_epoch() {
  local y=$((10#$1)) m=$((10#$2)) d=$((10#$3))
  local hh=$((10#$4)) mm=$((10#$5)) ss=$((10#$6))
  local sign="$7" oh=$((10#$8)) om=$((10#$9))
  local era yoe doy doe days offset
  ((m <= 2)) && y=$((y - 1))
  era=$((y / 400))
  yoe=$((y - era * 400))
  if ((m > 2)); then
    doy=$(((153 * (m - 3) + 2) / 5 + d - 1))
  else
    doy=$(((153 * (m + 9) + 2) / 5 + d - 1))
  fi
  doe=$((yoe * 365 + yoe / 4 - yoe / 100 + doy))
  days=$((era * 146097 + doe - 719468))
  offset=$((oh * 3600 + om * 60))
  [[ "$sign" == "-" ]] && offset=$((-offset))
  printf '%s\n' "$((days * 86400 + hh * 3600 + mm * 60 + ss - offset))"
}

# --- whose microphone is it -------------------------------------------

# Role of a pid seen in coreaudiod's log: `slack`, `macwhisper`, or `other`.
#
# `ps` can only name a live process, and a Slack Helper may exit when the
# huddle does -- exactly when this script needs to know it was Slack. So a
# role learned while the process was alive is kept in PID_CACHE and used when
# `ps` can no longer answer. The cache is rewritten each run with only the
# pids present in the current log window, which bounds it and keeps a stale
# entry from outliving the window in which a reused pid could be mistaken
# for it.
declare -A ROLE_OF=()
declare -A CACHED_ROLE=()

load_pid_cache() {
  local pid role
  [[ -f "$PID_CACHE" ]] || return 0
  while read -r pid role || [[ -n "$pid" ]]; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    [[ "$role" == "slack" || "$role" == "macwhisper" ]] || continue
    CACHED_ROLE[$pid]="$role"
  done <"$PID_CACHE"
}

classify_comm() {
  local comm="$1" base="${1##*/}"
  if [[ "$comm" == *"/Slack.app/"* && "$base" == "Slack Helper"* ]]; then
    printf 'slack\n'
  elif [[ "$base" == "MacWhisper" ]]; then
    printf 'macwhisper\n'
  else
    printf 'other\n'
  fi
}

resolve_role() {
  local pid="$1" comm
  [[ -z "${ROLE_OF[$pid]:-}" ]] || return 0
  if comm=$("$PS_BIN" -p "$pid" -o comm= 2>/dev/null) && [[ -n "$comm" ]]; then
    ROLE_OF[$pid]=$(classify_comm "$comm")
  else
    ROLE_OF[$pid]="${CACHED_ROLE[$pid]:-other}"
  fi
}

save_pid_cache() {
  local tmp pid
  mkdir -p "$(dirname -- "$PID_CACHE")" 2>/dev/null || return 0
  tmp=$(mktemp "${PID_CACHE}.XXXXXX" 2>/dev/null) || return 0
  for pid in "${!ROLE_OF[@]}"; do
    [[ "${ROLE_OF[$pid]}" == "other" ]] && continue
    printf '%s %s\n' "$pid" "${ROLE_OF[$pid]}" >>"$tmp"
  done
  mv "$tmp" "$PID_CACHE" 2>/dev/null || rm -f "$tmp"
}

# True while the pid is still MacWhisper. Asked of MacWhisper's own pid from
# its `yes` event: if MacWhisper has quit, it is not recording anything.
macwhisper_alive() {
  local comm role
  comm=$("$PS_BIN" -p "$1" -o comm= 2>/dev/null) || return 1
  role=$(classify_comm "$comm")
  [[ "$role" == "macwhisper" ]]
}

# --- read coreaudiod's log ---------------------------------------------

# --style syslog lines look like:
#   2026-09-24 08:15:14.577357-0700  localhost coreaudiod[563]: (CoreAudio)    SystemStatusWrapper.mm:89     SystemStatusWrapper::PublishRecordingClientInfo: Report client 1215 running: no device: <private>
# The `device:` value is redacted, but the pid and the state are not.
EVENT_RE='^([0-9]{4})-([0-9]{2})-([0-9]{2}) ([0-9]{2}):([0-9]{2}):([0-9]{2})(\.[0-9]+)?([+-])([0-9]{2})([0-9]{2}) .*PublishRecordingClientInfo: Report client ([0-9]+) running: (yes|no)'

rc=0
raw=$("$OSLOG_BIN" show --last "${WINDOW_MINUTES}m" --style syslog \
  --predicate 'process == "coreaudiod" AND eventMessage CONTAINS "PublishRecordingClientInfo: Report client"' \
  2>/dev/null) || rc=$?
if ((rc != 0)); then
  log_to_file "ERROR log show exited $rc; cannot check for a running recorder"
  echo "Error: '$OSLOG_BIN show' failed (exit $rc)." >&2
  exit 1
fi

load_pid_cache

# Parallel arrays, one entry per Slack or MacWhisper event, oldest first.
EV_T=()
EV_ROLE=()
EV_STATE=()
EV_PID=()
while IFS= read -r line; do
  [[ "$line" =~ $EVENT_RE ]] || continue
  pid="${BASH_REMATCH[11]}"
  resolve_role "$pid"
  role="${ROLE_OF[$pid]}"
  [[ "$role" == "other" ]] && continue
  EV_T+=("$(to_epoch "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" \
    "${BASH_REMATCH[4]}" "${BASH_REMATCH[5]}" "${BASH_REMATCH[6]}" \
    "${BASH_REMATCH[8]}" "${BASH_REMATCH[9]}" "${BASH_REMATCH[10]}")")
  EV_ROLE+=("$role")
  EV_STATE+=("${BASH_REMATCH[12]}")
  EV_PID+=("$pid")
done <<<"$raw"

if [[ $DRY_RUN -ne 1 ]]; then
  save_pid_cache
fi

# Every early exit below is the normal, quiet case: nothing is logged, since
# this runs every 30 seconds and a line per run would bury the alerts.
quiet_exit() {
  [[ $DRY_RUN -eq 1 ]] && echo "(dry run) no alert: $1"
  exit 0
}

# --- did a huddle MacWhisper was recording just end? -------------------

# 1. The huddle ended at Slack's most recent `no`, and only if nothing from
#    Slack has followed it. A later `yes` means the huddle is still going
#    (or a new one started).
last_slack=-1
for ((i = ${#EV_T[@]} - 1; i >= 0; i--)); do
  if [[ "${EV_ROLE[i]}" == "slack" ]]; then
    last_slack=$i
    break
  fi
done
((last_slack >= 0)) || quiet_exit "no Slack microphone activity in the last ${WINDOW_MINUTES}m"
[[ "${EV_STATE[last_slack]}" == "no" ]] || quiet_exit "Slack is still using the microphone"
release=${EV_T[last_slack]}

# 2. It must have stayed released for SETTLE_SECONDS, so a flap is not an end.
age=$((NOW - release))
((age >= SETTLE_SECONDS)) || quiet_exit "Slack released the microphone ${age}s ago; waiting for ${SETTLE_SECONDS}s"
((age <= MAX_AGE_MINUTES * 60)) || quiet_exit "the last huddle ended more than ${MAX_AGE_MINUTES}m ago"

# 3. Find where that huddle started: walk back through Slack's events to the
#    FIRST `yes` of the session. A `no` that held for SETTLE_SECONDS before
#    the next `yes` is the end of an earlier huddle, and the boundary. The
#    earliest `yes` matters rather than the latest: on 2026-09-24 Slack
#    flapped until 08:01:27, after MacWhisper's 08:01:23 `yes`, so anchoring
#    on the latest would have missed that MacWhisper was recording.
start=""
next_yes=""
for ((i = last_slack - 1; i >= 0; i--)); do
  [[ "${EV_ROLE[i]}" == "slack" ]] || continue
  if [[ "${EV_STATE[i]}" == "yes" ]]; then
    start=${EV_T[i]}
    next_yes=$start
  elif [[ -n "$next_yes" ]] && ((next_yes - EV_T[i] >= SETTLE_SECONDS)); then
    break
  fi
done
[[ -n "$start" ]] || quiet_exit "the huddle's start is outside the ${WINDOW_MINUTES}m window"

# 4. MacWhisper must have started using the microphone during that huddle.
#    SETTLE_SECONDS of lead is allowed for a recording started just before
#    joining. The LAST such `yes` is the one that matters: a recording
#    finished after it is what proves MacWhisper stopped.
mw_yes=""
mw_pid=""
for ((i = 0; i <= last_slack; i++)); do
  [[ "${EV_ROLE[i]}" == "macwhisper" && "${EV_STATE[i]}" == "yes" ]] || continue
  ((EV_T[i] >= start - SETTLE_SECONDS)) || continue
  mw_yes=${EV_T[i]}
  mw_pid=${EV_PID[i]}
done
[[ -n "$mw_yes" ]] || quiet_exit "MacWhisper did not record this huddle"

# 5. MacWhisper cannot be recording if it has quit.
macwhisper_alive "$mw_pid" || quiet_exit "MacWhisper (pid $mw_pid) is no longer running"

# --- has MacWhisper saved a recording since? ---------------------------

# The proof that capture stopped is MacWhisper saving the meeting's audio: a
# mediafile row of one of the three audio types huddle-transcribe and
# huddle-watch use, created after MacWhisper's own mic `yes`. The row is
# written when MacWhisper finalizes the meeting -- on every live-captured
# session so far, about a second after the session's final dateUpdated.
#
# This used to read recordedmeeting.dateCreated (and systemaudiorecording's),
# which until 2026-09-24 was the moment capture stopped. Since MacWhisper began
# capturing meetings live that evening, it is the moment capture STARTED,
# which can precede MacWhisper's mic `yes`. A saved meeting then never
# counted, and every ended huddle alerted three times. Oct 5 and 7: the first
# alert was right (still recording); the two after the save were false.
# Reading the start time could also fail the other way -- a row written at the
# start of a meeting and dated after the `yes` would silence the guard while
# MacWhisper was still recording -- so recordedmeeting is not read at all.
#
# The comparison is against MacWhisper's `yes`, not Slack's release. Someone
# who stops the recording and then leaves the huddle produces a row that
# predates the release, and comparing against the release would alert on a
# recording that had already stopped.
#
# Deleted sessions are deliberately NOT filtered: a recording saved and then
# deleted still proves the capture stopped.
#
# The upper bound at NOW is a no-op in normal use (no row is written in the
# future) and is what lets HUDDLE_GUARD_NOW replay a past day against a real
# database that has since gained that day's row.
FINISHED_QUERY="
SELECT count(*) FROM mediafile
WHERE type IN ('mergedMultitrack', 'meetingAppAudio', 'meetingMicAudio')
  AND CAST(strftime('%s', dateCreated) AS INTEGER) >= $mw_yes
  AND CAST(strftime('%s', dateCreated) AS INTEGER) <= $NOW
"

# Read-only, both ways, with a short retry on WAL lock contention; see
# huddle-watch's sql(). stderr is kept out of the result.
finished=""
for attempt in 1 2 3; do
  rc=0
  finished=$(sqlite3 -readonly "file:${DB}?mode=ro" "$FINISHED_QUERY" 2>/dev/null) || rc=$?
  ((rc == 0)) && break
  if ((attempt < 3)); then
    sleep 0.5
  fi
done
if ((rc != 0)) || ! [[ "$finished" =~ ^[0-9]+$ ]]; then
  # Failing without alerting is a choice: an alert here would fire on every
  # transient lock, and the next run is 30 seconds away.
  log_to_file "ERROR could not query $DB (exit $rc); skipping this check"
  echo "Error: failed to query MacWhisper database at $DB" >&2
  exit 1
fi
((finished == 0)) || quiet_exit "MacWhisper saved a recording after it started recording this huddle"

# --- alert, once per huddle end (plus bounded repeats) -----------------

# State is one line: "<release-epoch> <alerts-raised> <last-alert-epoch>".
# Keyed on the release time, so each huddle end is its own alert budget.
count=0
last_alert=0
if [[ -s "$STATE_FILE" ]]; then
  s_release="" s_count="" s_last=""
  read -r s_release s_count s_last <"$STATE_FILE" || true
  if [[ "$s_release" == "$release" && "$s_count" =~ ^[0-9]+$ && "$s_last" =~ ^[0-9]+$ ]]; then
    count=$((10#$s_count))
    last_alert=$((10#$s_last))
  fi
fi
((count < MAX_ALERTS)) || quiet_exit "already alerted $count time(s) for this huddle"
if ((count > 0 && NOW - last_alert < REALERT_SECONDS)); then
  quiet_exit "alerted $((NOW - last_alert))s ago; next repeat after ${REALERT_SECONDS}s"
fi

printf -v ended '%(%H:%M:%S)T' "$release"
minutes=$((age / 60))
title="Huddle ended — MacWhisper is still recording"
message="The Slack huddle ended at $ended (${minutes} min ago), but MacWhisper has not saved a recording since. It is probably still capturing the room. Open MacWhisper and finish the recording."

if [[ $DRY_RUN -eq 1 ]]; then
  echo "(dry run) would alert ($((count + 1))/$MAX_ALERTS): $message"
  exit 0
fi

# Record the alert BEFORE raising it. If the state write fails, the alert
# still goes out -- a missed alert is the worse failure -- but it is logged,
# since every later run will then alert again.
count=$((count + 1))
state_ok=1
if mkdir -p "$(dirname -- "$STATE_FILE")" 2>/dev/null &&
  state_tmp=$(mktemp "${STATE_FILE}.XXXXXX" 2>/dev/null); then
  if printf '%s %s %s\n' "$release" "$count" "$NOW" >"$state_tmp" &&
    mv "$state_tmp" "$STATE_FILE"; then
    :
  else
    rm -f "$state_tmp"
    state_ok=0
  fi
else
  state_ok=0
fi
((state_ok == 1)) || log_to_file "ERROR could not write $STATE_FILE; the next run will alert again"

raise_alert "$title" "$message"
log_to_file "ALERT ($count/$MAX_ALERTS) Slack released the mic at $ended; no MacWhisper recording saved since its mic start (pid $mw_pid)"
echo "ALERT ($count/$MAX_ALERTS): $message"
exit 0
