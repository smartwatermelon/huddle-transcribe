#!/usr/bin/env bash
# huddle-transcribe: select, transcribe, and diarize MacWhisper meeting recordings via `mw`.
set -euo pipefail

DB="$HOME/Library/Application Support/MacWhisper/Database/main.sqlite"
MEDIA_DIR="$HOME/Library/Application Support/MacWhisper/Database/ExternalMedia"
CONFIG_FILE="$HOME/.config/huddle-transcribe/config"
# Lives in the user's Google Drive so transcripts sync automatically and are
# reachable from the knowledge base. macOS names that mount
# GoogleDrive-<account email>, so the only way to point at it without a
# config override is to glob for whichever account is signed in -- hardcoding
# one account's email here would bake a real address into this public repo's
# source and git history. Falls back to a Drive-free default when no such
# mount exists (no Google Drive installed, or not yet signed in).
DEFAULT_OUTPUT_DIR="$HOME/Documents/huddle-transcripts"
shopt -s nullglob
drive_dirs=("$HOME/Library/CloudStorage"/GoogleDrive-*)
shopt -u nullglob
if [[ ${#drive_dirs[@]} -eq 1 && -d "${drive_dirs[0]}/My Drive/knowledge-base" ]]; then
  DEFAULT_OUTPUT_DIR="${drive_dirs[0]}/My Drive/knowledge-base/transcripts"
fi
# Floor for `latest` and date lookups; an explicit session id ignores it.
# Same variable and validation as huddle-watch. `-` rather than `:-`, so an
# explicitly empty HUDDLE_MIN_DURATION is rejected instead of becoming 300.
MIN_DURATION_SECONDS="${HUDDLE_MIN_DURATION-300}"
# Interpolated into SQL below, so it must be a plain integer before then.
if ! [[ "$MIN_DURATION_SECONDS" =~ ^[0-9]+$ ]]; then
  echo "Error: HUDDLE_MIN_DURATION must be a whole number of seconds (got '$MIN_DURATION_SECONDS')." >&2
  exit 1
fi
MW_BIN="/usr/local/bin/mw"

OUTPUT_DIR="$DEFAULT_OUTPUT_DIR"
if [[ -f "$CONFIG_FILE" ]]; then
  # Parsed with sed rather than sourced, deliberately: the config file
  # cannot execute shell code. OUTPUT_DIR is the only key this script reads,
  # and a later OUTPUT_DIR= line wins over an earlier one. The file is shared
  # with the huddle-review skill, which reads its own KB_* keys from it and
  # must honor the same parse-never-source rule.
  # The value is taken literally and never evaluated, so a path containing
  # `$VAR` or backticks is treated as those characters -- they are legal in
  # a directory name, and are not expanded or run. It is used only inside
  # double quotes downstream, so it never re-enters a parsing context.
  config_output_dir=$(sed -n -E 's/^OUTPUT_DIR=["'"'"']?([^"'"'"']*)["'"'"']?[[:space:]]*$/\1/p' "$CONFIG_FILE" | tail -1)
  # Because the value is never evaluated by the shell, a leading ~ arrives
  # literally and would create a directory actually named "~". Expand it
  # here; anything else stays untouched.
  tilde="~"
  if [[ "$config_output_dir" == "$tilde" ]]; then
    config_output_dir="$HOME"
  elif [[ "$config_output_dir" == "$tilde/"* ]]; then
    config_output_dir="$HOME/${config_output_dir:2}"
  fi
  [[ -n "$config_output_dir" ]] && OUTPUT_DIR="$config_output_dir"
fi

DRY_RUN=0
LIST=0
MARK_REVIEWED=0
ALL=0
ASSUME_YES=0
TARGET=""

usage() {
  cat <<'EOF'
Usage: huddle-transcribe [OPTIONS] [SESSION_ID_OR_DATE]

Arguments:
  SESSION_ID_OR_DATE   'latest' (default), YYYY-MM-DD, or a MacWhisper session UUID

Options:
  --dry-run             Show which session would be selected; changes nothing
  --list                List recent MacWhisper sessions (last 10) with metadata
  --all                 Transcribe every qualifying session that has no
                        sidecar in the output dir yet, oldest first, after
                        one confirmation (or none with --yes)
  --mark-reviewed       Set reviewed=true and remove the source .m4a for
                        SESSION_ID_OR_DATE (moved to Trash where trash(1) is
                        available, otherwise deleted outright)
  --yes                 Skip confirmation prompt
  --output-dir PATH     Override default output dir
  -h, --help            Show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --list)
      LIST=1
      shift
      ;;
    --mark-reviewed)
      MARK_REVIEWED=1
      shift
      ;;
    --all)
      ALL=1
      shift
      ;;
    --yes)
      ASSUME_YES=1
      shift
      ;;
    --output-dir)
      if [[ $# -lt 2 ]]; then
        echo "Error: --output-dir requires a PATH argument" >&2
        exit 1
      fi
      OUTPUT_DIR="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [[ -n "$TARGET" ]]; then
        echo "Error: unexpected extra argument '$1' (already selecting '$TARGET')" >&2
        exit 1
      fi
      # An empty argument is almost always an unset variable in a caller's
      # script (`huddle-transcribe "$SESSION"`). Treating it as "latest"
      # would silently operate on the newest recording -- and with
      # --mark-reviewed --yes, delete its audio.
      if [[ -z "$1" ]]; then
        echo "Error: empty SESSION_ID_OR_DATE argument" >&2
        exit 1
      fi
      TARGET="$1"
      shift
      ;;
  esac
done

if [[ $ALL -eq 1 ]]; then
  if [[ -n "$TARGET" ]]; then
    echo "Error: --all selects its own sessions; drop '$TARGET' or drop --all." >&2
    exit 1
  fi
  # The destructive path stays one session at a time: each of its guards
  # exists to stop it acting on the wrong session, and a batch is exactly the
  # setting where that mistake would repeat.
  if [[ $MARK_REVIEWED -eq 1 ]]; then
    echo "Error: --all cannot be combined with --mark-reviewed." >&2
    exit 1
  fi
  if [[ $LIST -eq 1 ]]; then
    echo "Error: --all cannot be combined with --list." >&2
    exit 1
  fi
fi

for dep in sqlite3 jq; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    echo "Error: required command '$dep' not found on PATH." >&2
    exit 1
  fi
done

if [[ ! -x "$MW_BIN" ]]; then
  echo "Error: mw CLI not found at $MW_BIN. Check MacWhisper install." >&2
  exit 1
fi

# Checked explicitly so a missing MacWhisper install reports itself, rather
# than surfacing as `Error: in prepare, no such table: session`.
if [[ ! -r "$DB" ]]; then
  echo "Error: MacWhisper database not readable at $DB" >&2
  echo "Is MacWhisper Pro installed and has it recorded at least one meeting?" >&2
  exit 1
fi

mkdir -p "$OUTPUT_DIR"

# Rows are separated by a unit-separator (0x1F), not a tab. Tab is IFS
# whitespace, so `IFS=$'\t' read` COLLAPSES runs of consecutive tabs into a
# single delimiter -- which silently shifts every later field whenever a
# column is empty. That is the common case here: a session normally has
# just one of the three media types, leaving two empty filename columns.
# 0x1F is not IFS whitespace, so empty fields are preserved positionally,
# and it cannot occur in a filename or a meeting title.
SEP=$'\x1f'

sql() {
  sqlite3 -separator "$SEP" "$DB" "$1"
}

# A newline inside a field would still split one row into two, so the title
# is scrubbed of tab/CR/LF in SQL -- it is the only free-text field a user
# can type anything into. It is also selected LAST, so that even an
# unscrubbed control character truncates the title rather than displacing a
# filename column and pointing SOURCE_PATH at a fragment of a name.
#
# Columns, separated by $SEP (0x1F):
#   session_id, dateCreated, duration,
#   merged_filename, app_audio_filename, mic_audio_filename, title
SESSION_SELECT="
SELECT
  lower(hex(s.id)),
  s.dateCreated,
  COALESCE(rm.duration, sar.duration, 0),
  COALESCE((SELECT filename FROM mediafile WHERE sessionID = s.id AND type = 'mergedMultitrack' LIMIT 1), ''),
  COALESCE((SELECT filename FROM mediafile WHERE sessionID = s.id AND type = 'meetingAppAudio' LIMIT 1), ''),
  COALESCE((SELECT filename FROM mediafile WHERE sessionID = s.id AND type = 'meetingMicAudio' LIMIT 1), ''),
  replace(replace(replace(
    COALESCE(s.userChosenTitle, s.aiTitle, rm.title, sar.title, 'Untitled'),
    char(9), ' '), char(10), ' '), char(13), ' ')
FROM session s
LEFT JOIN recordedmeeting rm ON rm.id = s.recordedMeetingID
LEFT JOIN systemaudiorecording sar ON sar.id = s.systemAudioRecordingID
"
# Used by `latest`, date lookup and --list: the floor keeps accidental short
# clips from being auto-selected.
SESSION_QUERY="$SESSION_SELECT
WHERE COALESCE(rm.duration, sar.duration, 0) > $MIN_DURATION_SECONDS
ORDER BY s.dateCreated DESC
"
# Used by lookup by explicit session id: naming an id is unambiguous, so no
# duration heuristic applies (a real 4m14s huddle was unreachable, #37).
SESSION_QUERY_ANY="$SESSION_SELECT
ORDER BY s.dateCreated DESC
"
# Used by --all: the same floor as `latest`, minus sessions deleted inside
# MacWhisper (whose audio is usually gone too), oldest first so a batch
# reads in the order the meetings happened.
SESSION_QUERY_PENDING="$SESSION_SELECT
WHERE COALESCE(rm.duration, sar.duration, 0) > $MIN_DURATION_SECONDS
  AND s.dateDeleted IS NULL
ORDER BY s.dateCreated ASC
"

slugify() {
  local slug
  slug=$(echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
  # A title that is empty, or made entirely of punctuation or non-ASCII
  # characters, reduces to "". That would produce an output basename of
  # "<date>_.md" -- a hidden dotfile that the user is unlikely to find.
  [[ -n "$slug" ]] || slug="untitled"
  echo "$slug"
}

fmt_duration() {
  local secs="${1:-0}"
  # Durations arrive from SQLite as either an integer or a float
  # ("1076" or "1076.5"); strip any fractional part before arithmetic,
  # since bash cannot do floating point. A non-numeric or empty value
  # would otherwise abort the script on an arithmetic syntax error.
  secs="${secs%.*}"
  [[ "$secs" =~ ^[0-9]+$ ]] || secs=0
  printf "%dm%02ds" "$((secs / 60))" "$((secs % 60))"
}

# Regenerates OUTPUT_DIR/_index.md from every *.meta.json sidecar present.
# Called only after a successful transcribe or --mark-reviewed -- never from
# --list or --dry-run, both of which are read-only paths.
#
# A sidecar is skipped, not fatal, when it fails to parse: one bad file must
# not stop the whole directory's index from being written, matching
# huddle-migrate-md's precedent for a corrupt sidecar (see its survey step).
write_index() {
  local index="$OUTPUT_DIR/_index.md"
  local sep=$'\x1f'

  # A literal-match glob, so an empty OUTPUT_DIR yields zero candidates
  # rather than the unexpanded pattern "*.meta.json" under set -e.
  shopt -s nullglob
  local metas=("$OUTPUT_DIR"/*.meta.json)
  shopt -u nullglob

  # Row fields are joined with $sep (0x1F), not a tab, for the same reason
  # SESSION_QUERY does: tab is IFS whitespace and would collapse if any
  # field were ever empty. title is read last so a stray control character
  # in a hand-edited sidecar truncates the title rather than displacing
  # output_file.
  local idx_rows=() meta line date dur reviewed output_file title
  for meta in "${metas[@]}"; do
    # jq -r (not -e): -e treats a final false/null/empty-string value as
    # failure, which would misclassify a valid reviewed:false sidecar as
    # malformed. A genuinely unparseable file still makes jq exit nonzero.
    if ! line=$(jq -r --arg sep "$sep" \
      '[(.date // ""), (.duration_seconds // 0 | tostring), ((.reviewed // false) | tostring), (.output_file // ""), (.title // "")] | join($sep)' \
      "$meta" 2>/dev/null); then
      continue
    fi
    IFS="$sep" read -r date dur reviewed output_file title <<<"$line" || true
    # No output_file means no link is possible; the row would be useless.
    [[ -n "$output_file" ]] || continue

    if [[ -z "$title" ]]; then
      # Sidecars written before this field existed have no title. Fall back
      # to de-slugifying the basename: strip the YYYY-MM-DD_ prefix and the
      # _<8-hex-id>.md suffix, then turn dashes back into spaces. Minimal on
      # purpose -- this is a fallback, not a real de-slugify.
      local base slug
      base="${output_file##*/}"
      slug="${base#??????????_}"
      slug="${slug%_????????.md}"
      title="${slug//-/ }"
      [[ -n "$title" ]] || title="(untitled)"
    fi

    # A literal pipe in a free-text title would break the Markdown table.
    title="${title//|/\\|}"

    idx_rows+=("${date}${sep}${title}${sep}${dur}${sep}${reviewed}${sep}${output_file}")
  done

  local body=""
  if [[ ${#idx_rows[@]} -gt 0 ]]; then
    # Newest first, matching --list. Sorting the whole joined row works
    # because date is a fixed-width YYYY-MM-DD prefix and sorts first.
    local idx_sorted
    idx_sorted=$(printf '%s\n' "${idx_rows[@]}" | sort -r)
    while IFS="$sep" read -r date title dur reviewed output_file; do
      local pretty_dur reviewed_word
      pretty_dur=$(fmt_duration "$dur")
      if [[ "$reviewed" == "true" ]]; then
        reviewed_word="yes"
      else
        reviewed_word="no"
      fi
      body+=$(printf '| %s | %s | %s | %s | [%s](%s) |\n' \
        "$date" "$title" "$pretty_dur" "$reviewed_word" "$output_file" "$output_file")
      body+=$'\n'
    done <<<"$idx_sorted"
  fi

  # mktemp beside the target, same rationale as every other write in this
  # script: OUTPUT_DIR is frequently a synced Drive folder on another
  # filesystem than $TMPDIR, and a same-directory rename is atomic.
  #
  # This function is called as `write_index || ...` by both callers, which
  # suppresses `set -e` for everything inside this function body -- a
  # failing command here no longer aborts the script on its own. Every
  # fallible step below is therefore checked explicitly and the function
  # returns nonzero on the first failure, rather than relying on -e.
  local tmp
  tmp=$(mktemp "${index}.XXXXXX") || return 1
  if ! {
    echo "<!-- Generated by huddle-transcribe. Do not hand-edit; it is overwritten on every transcribe / --mark-reviewed run. -->"
    echo
    echo "| Date | Title | Duration | Reviewed | File |"
    echo "| --- | --- | --- | --- | --- |"
    if [[ ${#idx_rows[@]} -eq 0 ]]; then
      echo "_No transcripts yet._"
    else
      printf '%s' "$body"
    fi
  } >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if ! mv "$tmp" "$index"; then
    rm -f "$tmp"
    return 1
  fi
}

# --- --list ---
if [[ $LIST -eq 1 ]]; then
  rows=$(sql "$SESSION_QUERY LIMIT 10")
  if [[ -z "$rows" ]]; then
    echo "No qualifying sessions found (duration > ${MIN_DURATION_SECONDS}s)." >&2
    exit 1
  fi
  printf "%-8s  %-19s  %-8s  %s\n" "SESSION" "DATE" "DURATION" "TITLE"
  while IFS="$SEP" read -r sid date dur _merged _app _mic title; do
    pretty_dur=$(fmt_duration "$dur")
    printf "%-8s  %-19s  %-8s  %s\n" "${sid:0:8}" "${date%.*}" "$pretty_dur" "$title"
  done <<<"$rows"
  exit 0
fi

# --- --all ---
# "Not yet transcribed" means no sidecar for the session in OUTPUT_DIR, found
# by the same id-suffix glob --mark-reviewed uses -- the sidecar is the state,
# and a title that changed since transcription must not make a session look
# pending again. Each session is then transcribed by a child invocation of
# this same script with an explicit id, so the batch reuses the single-session
# path, guards and all, rather than duplicating it.
if [[ $ALL -eq 1 ]]; then
  if ! all_rows=$(sql "$SESSION_QUERY_PENDING"); then
    echo "Error: failed to query MacWhisper database at $DB" >&2
    exit 1
  fi
  pending=()
  if [[ -n "$all_rows" ]]; then
    while IFS="$SEP" read -r sid date dur _merged _app _mic title; do
      shopt -s nullglob
      id_matches=("$OUTPUT_DIR"/*_"${sid:0:8}".meta.json)
      shopt -u nullglob
      [[ ${#id_matches[@]} -eq 0 ]] || continue
      if [[ ${#pending[@]} -eq 0 ]]; then
        printf "%-8s  %-19s  %-8s  %s\n" "SESSION" "DATE" "DURATION" "TITLE"
      fi
      pending+=("$sid")
      pretty_dur=$(fmt_duration "$dur")
      printf "%-8s  %-19s  %-8s  %s\n" "${sid:0:8}" "${date%.*}" "$pretty_dur" "$title"
    done <<<"$all_rows"
  fi
  if [[ ${#pending[@]} -eq 0 ]]; then
    echo "Nothing to transcribe: every qualifying session (duration > ${MIN_DURATION_SECONDS}s) has a sidecar in $OUTPUT_DIR."
    exit 0
  fi
  if [[ $DRY_RUN -eq 1 ]]; then
    echo "(dry run — would transcribe ${#pending[@]} session(s))"
    exit 0
  fi
  if [[ $ASSUME_YES -ne 1 ]]; then
    read -r -p "Transcribe these ${#pending[@]} session(s)? [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]] || {
      echo "Aborted."
      exit 1
    }
  fi
  # One failure does not stop the batch: the remaining sessions are
  # independent, and the summary names every failure so none is lost.
  failed=()
  n=0
  for sid in "${pending[@]}"; do
    n=$((n + 1))
    echo
    echo "[$n/${#pending[@]}] ${sid:0:8}"
    if ! "${BASH_SOURCE[0]}" --yes --output-dir "$OUTPUT_DIR" "$sid"; then
      failed+=("${sid:0:8}")
    fi
  done
  echo
  echo "Transcribed $((${#pending[@]} - ${#failed[@]})) of ${#pending[@]} session(s)."
  if [[ ${#failed[@]} -gt 0 ]]; then
    echo "Failed: ${failed[*]}" >&2
    exit 1
  fi
  exit 0
fi

# --- session selection ---
find_session_by_date() {
  local target_date="$1"
  # Validate the date is real, not merely well-shaped -- the caller's regex
  # only checks the digit pattern, so 2026-02-30 and 2026-13-01 reach here.
  # Done in pure bash rather than with date(1): `date -j` is BSD-only and
  # `date -d` is GNU-only, so either choice breaks on the other platform,
  # and BSD date silently ROLLS an out-of-range day (2026-02-30 becomes
  # 2026-03-02, exit 0) which makes it a poor validator regardless.
  local y="${target_date:0:4}" mo="${target_date:5:2}" d="${target_date:8:2}"
  # 10# forces base 10: a leading zero would otherwise be read as octal,
  # making 08 and 09 arithmetic errors.
  y=$((10#$y))
  mo=$((10#$mo))
  d=$((10#$d))
  local days_in_month=31
  case "$mo" in
    4 | 6 | 9 | 11) days_in_month=30 ;;
    2)
      days_in_month=28
      if ((y % 4 == 0 && (y % 100 != 0 || y % 400 == 0))); then
        days_in_month=29
      fi
      ;;
    *) ;; # 31-day months and out-of-range values; the bounds check follows
  esac
  if ((mo < 1 || mo > 12 || d < 1 || d > days_in_month)); then
    echo "Error: invalid date '$target_date' (expected a real YYYY-MM-DD)" >&2
    exit 1
  fi

  # Match on the stored calendar date, not on a distance between timestamps.
  # The previous version anchored the target at 08:00 America/Los_Angeles
  # but parsed row timestamps as UTC, so the comparison mixed two zones and
  # a 16h half-width window spanned 32h -- a session stored at 00:30 on the
  # 27th matched BOTH the 26th and the 27th. Comparing the date prefix is
  # exact, timezone-agnostic, needs no window, and matches what --list
  # prints, which is what a user is reading when they type a date.
  local matches=0 best_sid="" all_rows
  # Collect first, then loop over the result. Piping sql directly into the
  # loop would mask its exit status (SC2312), and a process substitution
  # cannot report a failed query at all -- an unreadable or corrupt
  # database would silently look like "no sessions found".
  if ! all_rows=$(sql "$SESSION_QUERY"); then
    echo "Error: failed to query MacWhisper database at $DB" >&2
    exit 1
  fi
  [[ -n "$all_rows" ]] || return 0
  # Rows arrive newest-first, so the first match on a day is that day's
  # latest session.
  while IFS="$SEP" read -r sid date _dur _merged _app _mic _title; do
    [[ "${date%% *}" == "$target_date" ]] || continue
    matches=$((matches + 1))
    [[ -n "$best_sid" ]] || best_sid="$sid"
  done <<<"$all_rows"

  if [[ -z "$best_sid" ]]; then
    echo "Error: no qualifying session on $target_date (duration > ${MIN_DURATION_SECONDS}s; an explicit session id bypasses that). Try --list." >&2
    return 1
  fi
  if ((matches > 1)); then
    echo "Note: $matches sessions on $target_date; using the most recent (${best_sid:0:8}). Pass a session id to pick another." >&2
  fi
  # best_sid is a bare hex session id (no delimiters), safe to re-look-up
  # cleanly rather than round-tripping title/filename fields through a
  # delimiter that could appear in a session title.
  find_session_by_id "$best_sid"
}

find_session_by_id() {
  local partial="$1"
  # Session ids are selected as lower(hex(s.id)) -- bare hex, no dashes.
  # A UUID copied out of MacWhisper's own UI is dashed, so strip dashes
  # before matching or such an id never matches anything.
  partial="${partial//-/}"
  if [[ -z "$partial" ]]; then
    echo "Error: empty session id" >&2
    exit 1
  fi
  if ! [[ "$partial" =~ ^[0-9a-fA-F]+$ ]]; then
    echo "Error: '$1' is not a session id (expected hex, or a YYYY-MM-DD date). Try --list." >&2
    exit 1
  fi
  # Check the query separately rather than piping it straight into awk: a
  # pipeline masks sqlite3's exit status, so an unreadable or corrupt
  # database reported "no such session" instead of naming the real problem.
  local all_rows
  if ! all_rows=$(sql "$SESSION_QUERY_ANY"); then
    echo "Error: failed to query MacWhisper database at $DB" >&2
    exit 1
  fi
  # Split on $SEP, matching the rest of the script. With -F'\t' there are no
  # tabs in the row, so $1 would be the entire line and the prefix match
  # would work only because the id happens to sit first -- correct today,
  # but silently wrong after any column reorder.
  local hits
  hits=$(awk -F"$SEP" -v id="$partial" 'index(tolower($1), tolower(id)) == 1' <<<"$all_rows")
  [[ -n "$hits" ]] || return 1
  # An ambiguous prefix must not resolve silently: --mark-reviewed removes
  # audio, and "here is my guess" is the wrong default for that.
  local hit_count
  hit_count=$(grep -c . <<<"$hits")
  if ((hit_count > 1)); then
    echo "Error: session id '$1' is ambiguous; it matches:" >&2
    awk -F"$SEP" '{printf "  %s  %s  %s\n", $1, $2, $7}' <<<"$hits" >&2
    echo "Pass more characters of the id." >&2
    # Exit 3, not 1: the caller uses this to tell "already explained the
    # problem in detail" apart from a plain no-match, and suppress its own
    # generic message.
    exit 3
  fi
  printf '%s\n' "$hits"
}

find_latest_session() {
  local row
  # Same reasoning as find_session_by_id: report a query failure as one
  # rather than letting it look like an empty database.
  if ! row=$(sql "$SESSION_QUERY LIMIT 1"); then
    echo "Error: failed to query MacWhisper database at $DB" >&2
    exit 1
  fi
  [[ -n "$row" ]] || return 1
  printf '%s\n' "$row"
}

# These helpers end in a conditional whose false branch returns 1, and an
# unguarded assignment under `set -e` would abort here silently. Guard each
# one, but track whether the helper already explained itself: find_session_
# by_date prints a specific reason ("no session on <date>"), and following
# that with the generic message below is just noise.
SELECTED=""
selection_explained=0
if [[ -z "$TARGET" || "$TARGET" == "latest" ]]; then
  SELECTED=$(find_latest_session) || true
elif [[ "$TARGET" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  SELECTED=$(find_session_by_date "$TARGET") || selection_explained=1
else
  SELECTED=$(find_session_by_id "$TARGET") || [[ $? -ne 3 ]] || selection_explained=1
fi

if [[ -z "$SELECTED" ]]; then
  if [[ $selection_explained -eq 0 ]]; then
    echo "Error: no qualifying session found for '$TARGET'. Try --list." >&2
  fi
  exit 1
fi

# STITLE is read last so it absorbs any remaining tabs rather than shifting
# the filename columns. `read` returns nonzero on a final line with no
# trailing newline, which `set -e` would treat as fatal, hence `|| true`.
IFS="$SEP" read -r SID SDATE SDUR SMERGED SAPP SMIC STITLE <<<"$SELECTED" || true

# Prefer merged multitrack, then app audio, then mic audio.
SOURCE_FILENAME=""
if [[ -n "$SMERGED" ]]; then
  SOURCE_FILENAME="$SMERGED"
elif [[ -n "$SAPP" ]]; then
  SOURCE_FILENAME="$SAPP"
elif [[ -n "$SMIC" ]]; then
  SOURCE_FILENAME="$SMIC"
else
  echo "Error: session $SID has no usable audio file." >&2
  exit 1
fi

SOURCE_PATH="$MEDIA_DIR/$SOURCE_FILENAME"
SESSION_DATE_ONLY="${SDATE%% *}"
if ! [[ "$SESSION_DATE_ONLY" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  echo "Error: unexpected session date format '$SDATE'" >&2
  exit 1
fi
SLUG=$(slugify "$STITLE")
# The session id prefix disambiguates two sessions on the same date whose
# titles slugify identically ("SRE Daily Huddle" and "SRE/Daily Huddle"
# both become "sre-daily-huddle"). Without it the second transcribe
# silently overwrote the first, and --mark-reviewed could then delete the
# audio of a session whose transcript had already been replaced.
OUT_BASENAME="${SESSION_DATE_ONLY}_${SLUG}_${SID:0:8}"
# Markdown, not plain text, because the transcripts are read in Google Drive's
# web viewer, which previews .md inline but offers only a download prompt for
# .txt. The content difference from `--format txt` is one thing -- mw wraps the
# timestamp line in asterisks -- so the extension, not the markup, is the point.
# Crucially the four-line block structure (label / timestamp / body / blank) is
# byte-identical either way, which is what keeps the line-anchored rewrite in
# docs/plans/speaker-name-attribution.md valid. `--format html` would not: mw
# emits that as a single unbroken line for the entire transcript body.
OUT_DOC="$OUTPUT_DIR/${OUT_BASENAME}.md"
OUT_META="$OUTPUT_DIR/${OUT_BASENAME}.meta.json"

# --mark-reviewed acts on a sidecar written by an earlier run, so it must find
# that file rather than the name today's title would produce. MacWhisper keeps
# titling a session after its transcript is written -- a session captured as
# "Untitled" is routinely named minutes later -- and the derived basename then
# points at a file that never existed, stranding the audio forever.
#
# Resolve by the session id suffix instead, which is the stable part of the
# name. This is the primary lookup, not a fallback: the glob also matches the
# derived path whenever the title has not changed, so there is one code path.
# Two sidecars can share an 8-hex-char suffix, so an ambiguous match refuses
# rather than guesses; the session_id equality check below is what ultimately
# authorizes the delete, and it still runs on whatever the glob resolved.
if [[ $MARK_REVIEWED -eq 1 ]]; then
  shopt -s nullglob
  id_matches=("$OUTPUT_DIR"/*_"${SID:0:8}".meta.json)
  shopt -u nullglob
  if [[ ${#id_matches[@]} -gt 1 ]]; then
    echo "Error: ${#id_matches[@]} sidecars match session ${SID:0:8} in $OUTPUT_DIR:" >&2
    printf '  %s\n' "${id_matches[@]}" >&2
    echo "Refusing to delete source audio. Remove the stale sidecar and re-run." >&2
    exit 1
  fi
  if [[ ${#id_matches[@]} -eq 1 ]]; then
    OUT_META="${id_matches[0]}"
    # The sidecar names its own transcript. Deriving it from the sidecar's
    # basename would work today but re-encodes the naming scheme in a second
    # place; output_file is the field the write path already records, and the
    # -s guard below depends on this pointing at the real transcript.
    meta_output_file=$(jq -r '.output_file // empty' "$OUT_META" 2>/dev/null || true)
    if [[ -n "$meta_output_file" ]]; then
      OUT_DOC="$OUTPUT_DIR/$meta_output_file"
    fi
  fi
fi

echo "Session:  ${SID:0:8}"
echo "Date:     $SDATE"
SDUR_PRETTY=$(fmt_duration "$SDUR")
echo "Duration: $SDUR_PRETTY"
echo "Title:    $STITLE"
echo "Source:   $SOURCE_PATH"
echo "Output:   $OUT_DOC"

if [[ $MARK_REVIEWED -ne 1 && ! -f "$SOURCE_PATH" ]]; then
  echo "Error: source audio file not found at $SOURCE_PATH" >&2
  exit 1
fi

# --dry-run is checked before --mark-reviewed, and must stay that way.
# --dry-run is the flag a user reaches for when they are unsure what will be
# selected; combining it with --mark-reviewed previously deleted the audio
# anyway, because the deletion block ran first.
if [[ $DRY_RUN -eq 1 ]]; then
  if [[ $MARK_REVIEWED -eq 1 ]]; then
    echo "(dry run — would mark reviewed and delete $SOURCE_PATH)"
  else
    echo "(dry run — no transcription performed)"
  fi
  exit 0
fi

# --- --mark-reviewed ---
if [[ $MARK_REVIEWED -eq 1 ]]; then
  if [[ ! -f "$OUT_META" ]]; then
    echo "Error: no metadata sidecar found at $OUT_META. Transcribe first." >&2
    exit 1
  fi
  # The sidecar is located by session id suffix (see above), which is an
  # 8-hex-char prefix of a longer id and so is not by itself proof of identity.
  # Confirm it actually describes the session just resolved before deleting
  # anything: a same-day or suffix-colliding session could otherwise map onto a
  # sidecar belonging to a different recording.
  meta_session_id=$(jq -r '.session_id // empty' "$OUT_META" 2>/dev/null || true)
  if [[ -z "$meta_session_id" ]]; then
    echo "Error: $OUT_META is missing a session_id. Refusing to delete source audio." >&2
    exit 1
  fi
  if [[ "$meta_session_id" != "$SID" ]]; then
    echo "Error: sidecar $OUT_META describes session ${meta_session_id:0:8}, but the selected session is ${SID:0:8}." >&2
    echo "Refusing to delete source audio. Pass the session id explicitly to disambiguate." >&2
    exit 1
  fi
  # Deletion is irreversible and the transcript is the only thing that
  # survives it, so require that the transcript exists and is non-empty.
  if [[ ! -s "$OUT_DOC" ]]; then
    echo "Error: transcript $OUT_DOC is missing or empty. Refusing to delete source audio." >&2
    exit 1
  fi
  if [[ $ASSUME_YES -ne 1 ]]; then
    if command -v trash >/dev/null 2>&1; then
      delete_verb="move to Trash"
    else
      delete_verb="permanently delete"
    fi
    read -r -p "Mark reviewed and $delete_verb source .m4a ($SOURCE_PATH)? [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]] || {
      echo "Aborted."
      exit 1
    }
  fi
  # Order matters, and both obvious orderings are wrong:
  #
  #   record then delete -> a failed delete leaves the sidecar claiming a
  #                         deletion that never happened;
  #   delete then record -> a failed sidecar write leaves the audio gone
  #                         while the sidecar still says deleted_source:false.
  #
  # So split the write. Build the updated sidecar into a temp file FIRST --
  # that is the fallible part (jq missing, ENOSPC, permissions) and it
  # touches nothing real. Then delete the audio. Then rename the temp file
  # into place; a same-directory rename is atomic and essentially cannot
  # fail once the temp file exists. That leaves no window in which the
  # sidecar and the filesystem disagree.
  #
  # mktemp beside the sidecar, not in $TMPDIR: rename is only atomic within
  # one filesystem, and $TMPDIR is frequently on another one when
  # OUTPUT_DIR points at an external or synced volume.
  tmp=$(mktemp "${OUT_META}.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  if ! jq '.reviewed = true | .deleted_source = true' "$OUT_META" >"$tmp" || [[ ! -s "$tmp" ]]; then
    echo "Error: failed to prepare metadata sidecar $OUT_META. Source audio left in place." >&2
    exit 1
  fi

  # Prefer trash(1) (macOS 14+) so a mistake is recoverable from Finder.
  # This is the only irreversible step in the script, and the guards above
  # are the sole protection once the audio is really gone.
  source_was_present=1
  if [[ ! -f "$SOURCE_PATH" ]]; then
    source_was_present=0
  elif command -v trash >/dev/null 2>&1; then
    if ! trash "$SOURCE_PATH"; then
      echo "Error: failed to trash $SOURCE_PATH. Sidecar left unchanged." >&2
      exit 1
    fi
  elif ! rm -f "$SOURCE_PATH"; then
    echo "Error: failed to delete $SOURCE_PATH. Sidecar left unchanged." >&2
    exit 1
  fi
  # Belt-and-braces for the trash(1) branch specifically: rm -f reports its
  # own failures, but trash can exit 0 without having moved the file.
  if [[ -e "$SOURCE_PATH" ]]; then
    echo "Error: $SOURCE_PATH still present after removal. Sidecar left unchanged." >&2
    exit 1
  fi

  mv "$tmp" "$OUT_META"
  trap - EXIT
  # The mark-reviewed operation is already durably complete at this point;
  # a failure inside write_index (e.g. ENOSPC, permissions on a synced
  # Drive folder) must not be reported as this command having failed --
  # that would tell --mark-reviewed's caller (a human, or a script) the
  # operation didn't happen, when the sidecar update and audio removal
  # both already succeeded. The index is a convenience view, rebuilt on
  # every run, so a stale one self-heals next time.
  write_index || echo "Warning: failed to regenerate $OUTPUT_DIR/_index.md" >&2
  if [[ $source_was_present -eq 1 ]]; then
    if command -v trash >/dev/null 2>&1; then
      echo "Marked reviewed and moved source to Trash: $SOURCE_PATH"
    else
      echo "Marked reviewed and deleted source: $SOURCE_PATH"
    fi
  else
    echo "Marked reviewed (source audio was already gone): $SOURCE_PATH"
  fi
  exit 0
fi

if [[ $ASSUME_YES -ne 1 ]]; then
  read -r -p "Transcribe this session? [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]] || {
    echo "Aborted."
    exit 1
  }
fi

# Transcribe to a temp path and move into place only once mw has succeeded
# and produced a non-empty file. Writing straight to $OUT_DOC means an
# interrupted or failed run (Ctrl-C, crash, full disk) destroys a previously
# good transcript, since mw is invoked with --overwrite.
DOC_TMP=$(mktemp "${OUT_DOC}.partial.XXXXXX")
trap 'rm -f "$DOC_TMP"' EXIT
if ! "$MW_BIN" transcribe \
  --speakers \
  --speaker-names \
  --timestamps \
  --end-timestamps \
  --format md \
  --overwrite \
  -o "$DOC_TMP" \
  "$SOURCE_PATH"; then
  echo "Error: mw transcribe failed for $SOURCE_PATH" >&2
  # No sidecar is written on failure. That is deliberate: --mark-reviewed
  # refuses to run without one, so a failed transcription can never lead to
  # the source audio being deleted.
  exit 1
fi

if [[ ! -s "$DOC_TMP" ]]; then
  echo "Error: mw reported success but produced no transcript at $OUT_DOC" >&2
  exit 1
fi

if ! grep -q "^\*\*Speaker " "$DOC_TMP" 2>/dev/null; then
  echo "Warning: no 'Speaker' labels found in output. Check MacWhisper Settings > speaker detection." >&2
fi

# --argjson parses its value as JSON and aborts on anything non-numeric, so
# guard the duration rather than letting a surprising DB value abort the run.
META_DURATION="$SDUR"
[[ "$META_DURATION" =~ ^[0-9]+(\.[0-9]+)?$ ]] || META_DURATION=0

# Build BOTH temp files before renaming EITHER into place. The transcript
# and its sidecar are a pair: --mark-reviewed refuses to run without a
# sidecar, so a transcript that landed while the sidecar write failed can
# never be cleaned up, and the meeting has to be transcribed again. Doing
# every fallible step first means the only thing left after them is two
# same-directory renames.
meta_tmp=$(mktemp "${OUT_META}.XXXXXX")
trap 'rm -f "$DOC_TMP" "$meta_tmp"' EXIT
if ! jq -n \
  --arg session_id "$SID" \
  --arg date "$SESSION_DATE_ONLY" \
  --argjson duration_seconds "$META_DURATION" \
  --arg source_file "$SOURCE_FILENAME" \
  --arg output_file "$(basename "$OUT_DOC")" \
  --arg title "$STITLE" \
  '{
    session_id: $session_id,
    date: $date,
    duration_seconds: $duration_seconds,
    source_file: $source_file,
    output_file: $output_file,
    title: $title,
    reviewed: false,
    deleted_source: false
  }' >"$meta_tmp"; then
  echo "Error: failed to write metadata sidecar $OUT_META. Transcript not saved." >&2
  exit 1
fi

mv "$DOC_TMP" "$OUT_DOC"
mv "$meta_tmp" "$OUT_META"
trap - EXIT
# Same reasoning as the --mark-reviewed call site above: the transcript and
# sidecar are already safely on disk, so a write_index failure must not
# turn a successful transcription into a nonzero exit -- huddle-watch reads
# that exit status to decide whether to retry, and retrying a transcription
# that already succeeded would silently re-run mw against the same audio.
write_index || echo "Warning: failed to regenerate $OUTPUT_DIR/_index.md" >&2

echo "Transcript written: $OUT_DOC"
echo "Metadata written:   $OUT_META"
