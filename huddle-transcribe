#!/usr/bin/env bash
# huddle-transcribe: select, transcribe, and diarize MacWhisper meeting recordings via `mw`.
set -euo pipefail

# Under bash 3.2 an empty array under set -u aborts as "unbound variable".
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2))); then
  printf 'Error: %s requires bash 4.2 or newer; running under %s (%s).\n' \
    "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" "${BASH:-unknown}" >&2
  printf 'macOS ships bash 3.2 at /bin/bash. Install a current bash (brew install bash).\n' >&2
  exit 1
fi

DB="$HOME/Library/Application Support/MacWhisper/Database/main.sqlite"
MEDIA_DIR="$HOME/Library/Application Support/MacWhisper/Database/ExternalMedia"
CONFIG_FILE="$HOME/.config/huddle-transcribe/config"
# Lives in the user's Google Drive so transcripts sync automatically and are
# reachable from the knowledge base. macOS names that mount
# GoogleDrive-<account email>, so the only way to point at it without a
# config override is to glob for whichever account is signed in -- hardcoding
# one account's email here would bake a real address into this public repo's
# source and git history. Falls back to a Drive-free default when no such
# mount exists (no Google Drive installed, or not yet signed in).
DEFAULT_OUTPUT_DIR="$HOME/Documents/huddle-transcripts"
shopt -s nullglob
drive_dirs=("$HOME/Library/CloudStorage"/GoogleDrive-*)
shopt -u nullglob
if [[ ${#drive_dirs[@]} -eq 1 && -d "${drive_dirs[0]}/My Drive/knowledge-base" ]]; then
  DEFAULT_OUTPUT_DIR="${drive_dirs[0]}/My Drive/knowledge-base/transcripts"
fi
# Floor for `latest` and date lookups; an explicit session id ignores it.
# Same variable and validation as huddle-watch. `-` rather than `:-`, so an
# explicitly empty HUDDLE_MIN_DURATION is rejected instead of becoming 300.
MIN_DURATION_SECONDS="${HUDDLE_MIN_DURATION-300}"
# Interpolated into SQL below, so it must be a plain integer before then.
if ! [[ "$MIN_DURATION_SECONDS" =~ ^[0-9]+$ ]]; then
  echo "Error: HUDDLE_MIN_DURATION must be a whole number of seconds (got '$MIN_DURATION_SECONDS')." >&2
  exit 1
fi
# Back-to-back same-app recordings this close are one split meeting; 0 disables.
STITCH_GAP_SECONDS="${HUDDLE_STITCH_GAP_SECONDS-60}"
if ! [[ "$STITCH_GAP_SECONDS" =~ ^[0-9]+$ ]]; then
  echo "Error: HUDDLE_STITCH_GAP_SECONDS must be a whole number of seconds (got '$STITCH_GAP_SECONDS')." >&2
  exit 1
fi
MW_BIN="/usr/local/bin/mw"
# Per-recording mw transcripts of split meetings, kept outside the KB for re-stitching.
PIECES_DIR="${HUDDLE_PIECES_DIR:-$HOME/.local/state/huddle-transcribe/pieces}"

OUTPUT_DIR="$DEFAULT_OUTPUT_DIR"
if [[ -f "$CONFIG_FILE" ]]; then
  # Parsed with sed rather than sourced, deliberately: the config file
  # cannot execute shell code. OUTPUT_DIR is the only key this script reads,
  # and a later OUTPUT_DIR= line wins over an earlier one. The file is shared
  # with the huddle-review skill, which reads its own KB_* keys from it and
  # must honor the same parse-never-source rule.
  # The value is taken literally and never evaluated, so a path containing
  # `$VAR` or backticks is treated as those characters -- they are legal in
  # a directory name, and are not expanded or run. It is used only inside
  # double quotes downstream, so it never re-enters a parsing context.
  config_output_dir=$(sed -n -E 's/^OUTPUT_DIR=["'"'"']?([^"'"'"']*)["'"'"']?[[:space:]]*$/\1/p' "$CONFIG_FILE" | tail -1)
  # Because the value is never evaluated by the shell, a leading ~ arrives
  # literally and would create a directory actually named "~". Expand it
  # here; anything else stays untouched.
  tilde="~"
  if [[ "$config_output_dir" == "$tilde" ]]; then
    config_output_dir="$HOME"
  elif [[ "$config_output_dir" == "$tilde/"* ]]; then
    config_output_dir="$HOME/${config_output_dir:2}"
  fi
  [[ -n "$config_output_dir" ]] && OUTPUT_DIR="$config_output_dir"
fi

DRY_RUN=0
LIST=0
MARK_REVIEWED=0
SKIP_EXISTING=0
ALL=0
RESTITCH=0
ASSUME_YES=0
TARGET=""
# Recordings of the meeting huddle-watch found not ready yet (--pending).
PENDING_ARGS=()

usage() {
  cat <<'EOF'
Usage: huddle-transcribe [OPTIONS] [SESSION_ID_OR_DATE]

Arguments:
  SESSION_ID_OR_DATE   'latest' (default), YYYY-MM-DD, or a MacWhisper session UUID

Options:
  --dry-run             Show which session would be selected; changes nothing
  --list                List recent MacWhisper sessions (last 10) with metadata
  --all                 Transcribe every qualifying session that has no
                        sidecar in the output dir yet, oldest first, after
                        one confirmation (or none with --yes)
  --mark-reviewed       Set reviewed=true and remove the source .m4a for
                        SESSION_ID_OR_DATE (moved to Trash where trash(1) is
                        available, otherwise deleted outright)
  --skip-existing       Exit 0 without transcribing when sidecars in the
                        output dir already name every recording of the meeting
  --restitch            What huddle-watch runs: --skip-existing, plus a
                        meeting that gained a recording replaces the
                        transcript an earlier --restitch run wrote, in place,
                        while it is unreviewed; reuses cached pieces
  --pending SESSION_ID  A recording of the meeting that is not ready yet: it
                        is left out and named at the end of the transcript
                        (repeatable; huddle-watch passes these)
  --yes                 Skip confirmation prompt
  --output-dir PATH     Override default output dir
  -h, --help            Show this help

A meeting MacWhisper split into back-to-back recordings of the same app is
one transcript, named after its first recording. Each recording is
transcribed on its own and the transcripts are joined, one part each.

An existing transcript is never overwritten: a second run writes the next
free name (<date>_<slug>-2_<id>.md, ...) with a note naming the first. The
one exception is --restitch, above.

Environment:
  HUDDLE_MIN_DURATION        Floor in seconds for latest/date/--list/--all,
                             applied to a stitched meeting's total (default 300)
  HUDDLE_STITCH_GAP_SECONDS  Largest gap in seconds between two recordings
                             of one meeting; 0 disables stitching (default 60)
  HUDDLE_PIECES_DIR          Cache of per-recording transcripts (default
                             ~/.local/state/huddle-transcribe/pieces)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --list)
      LIST=1
      shift
      ;;
    --mark-reviewed)
      MARK_REVIEWED=1
      shift
      ;;
    --all)
      ALL=1
      shift
      ;;
    --skip-existing)
      SKIP_EXISTING=1
      shift
      ;;
    --restitch)
      RESTITCH=1
      SKIP_EXISTING=1
      shift
      ;;
    --yes)
      ASSUME_YES=1
      shift
      ;;
    --pending)
      if [[ $# -lt 2 ]]; then
        echo "Error: --pending requires a SESSION_ID argument" >&2
        exit 1
      fi
      pending_arg=$(printf '%s' "${2//-/}" | tr '[:upper:]' '[:lower:]')
      if ! [[ "$pending_arg" =~ ^[0-9a-f]+$ ]]; then
        echo "Error: --pending '$2' is not a session id (expected hex)." >&2
        exit 1
      fi
      PENDING_ARGS+=("$pending_arg")
      shift 2
      ;;
    --output-dir)
      if [[ $# -lt 2 ]]; then
        echo "Error: --output-dir requires a PATH argument" >&2
        exit 1
      fi
      OUTPUT_DIR="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [[ -n "$TARGET" ]]; then
        echo "Error: unexpected extra argument '$1' (already selecting '$TARGET')" >&2
        exit 1
      fi
      # An empty argument is almost always an unset variable in a caller's
      # script (`huddle-transcribe "$SESSION"`). Treating it as "latest"
      # would silently operate on the newest recording -- and with
      # --mark-reviewed --yes, delete its audio.
      if [[ -z "$1" ]]; then
        echo "Error: empty SESSION_ID_OR_DATE argument" >&2
        exit 1
      fi
      TARGET="$1"
      shift
      ;;
  esac
done

if [[ $SKIP_EXISTING -eq 1 && $MARK_REVIEWED -eq 1 ]]; then
  echo "Error: --skip-existing and --restitch cannot be combined with --mark-reviewed." >&2
  exit 1
fi
if [[ $RESTITCH -eq 1 && $ALL -eq 1 ]]; then
  echo "Error: --restitch takes one session; it cannot be combined with --all." >&2
  exit 1
fi
if [[ ${#PENDING_ARGS[@]} -gt 0 && ($ALL -eq 1 || $MARK_REVIEWED -eq 1) ]]; then
  echo "Error: --pending names recordings of one meeting being transcribed; it cannot be combined with --all or --mark-reviewed." >&2
  exit 1
fi

if [[ $ALL -eq 1 ]]; then
  if [[ -n "$TARGET" ]]; then
    echo "Error: --all selects its own sessions; drop '$TARGET' or drop --all." >&2
    exit 1
  fi
  # The destructive path stays one session at a time: each of its guards
  # exists to stop it acting on the wrong session, and a batch is exactly the
  # setting where that mistake would repeat.
  if [[ $MARK_REVIEWED -eq 1 ]]; then
    echo "Error: --all cannot be combined with --mark-reviewed." >&2
    exit 1
  fi
  if [[ $LIST -eq 1 ]]; then
    echo "Error: --all cannot be combined with --list." >&2
    exit 1
  fi
fi

for dep in sqlite3 jq; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    echo "Error: required command '$dep' not found on PATH." >&2
    exit 1
  fi
done

if [[ ! -x "$MW_BIN" ]]; then
  echo "Error: mw CLI not found at $MW_BIN. Check MacWhisper install." >&2
  exit 1
fi

# Checked explicitly so a missing MacWhisper install reports itself, rather
# than surfacing as `Error: in prepare, no such table: session`.
if [[ ! -r "$DB" ]]; then
  echo "Error: MacWhisper database not readable at $DB" >&2
  echo "Is MacWhisper Pro installed and has it recorded at least one meeting?" >&2
  exit 1
fi

mkdir -p "$OUTPUT_DIR"

# Rows are separated by a unit-separator (0x1F), not a tab. Tab is IFS
# whitespace, so `IFS=$'\t' read` COLLAPSES runs of consecutive tabs into a
# single delimiter -- which silently shifts every later field whenever a
# column is empty. That is the common case here: a session normally has
# just one of the three media types, leaving two empty filename columns.
# 0x1F is not IFS whitespace, so empty fields are preserved positionally,
# and it cannot occur in a filename or a meeting title.
SEP=$'\x1f'

sql() {
  sqlite3 -separator "$SEP" "$DB" "$1"
}

# grp: same-app recordings (bundle id, else 'app:' || appName) chained into
# split meetings. Must match huddle-watch's GROUP_CTE row for row.
GROUP_CTE="
WITH rec AS (
  SELECT lower(hex(s.id)) AS sid,
    COALESCE(rm.bundleIdentifier, 'app:' || rm.appName) AS app,
    julianday(rm.date) AS t0,
    julianday(rm.date) + COALESCE(rm.duration, 0) / 86400.0 AS t1,
    COALESCE(rm.duration, 0) AS dur
  FROM session s JOIN recordedmeeting rm ON rm.id = s.recordedMeetingID
  WHERE s.dateDeleted IS NULL
    AND COALESCE(rm.bundleIdentifier, rm.appName) IS NOT NULL
    AND julianday(rm.date) IS NOT NULL
), gaps AS (
  SELECT *, (t0 - MAX(t1) OVER (PARTITION BY app ORDER BY t0, sid
    ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING)) * 86400.0 AS gap
  FROM rec
), num AS (
  SELECT *, SUM(CASE WHEN $STITCH_GAP_SECONDS > 0
      AND gap BETWEEN 0 AND $STITCH_GAP_SECONDS THEN 0 ELSE 1 END)
    OVER (PARTITION BY app ORDER BY t0, sid ROWS UNBOUNDED PRECEDING) AS gno
  FROM gaps
), grp AS (
  SELECT sid, t0, FIRST_VALUE(sid) OVER w AS lead, COUNT(*) OVER w AS n,
    SUM(dur) OVER w AS total, MAX(t1) OVER w AS last_end
  FROM num
  WINDOW w AS (PARTITION BY app, gno ORDER BY t0, sid
    ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
)"
# A split meeting's floor and displayed duration are its total; a single
# recording keeps exactly the old expression.
DURATION_EXPR="CASE WHEN g.n > 1 THEN g.total ELSE COALESCE(rm.duration, sar.duration, 0) END"
IS_GROUP_LEAD="(g.lead IS NULL OR g.lead = lower(hex(s.id)))"

# A newline inside a field would still split one row into two, so the title
# is scrubbed of tab/CR/LF in SQL -- it is the only free-text field a user
# can type anything into. It is also selected LAST, so that even an
# unscrubbed control character truncates the title rather than displacing a
# filename column and pointing SOURCE_PATH at a fragment of a name.
#
# Columns, separated by $SEP (0x1F):
#   session_id, dateCreated, duration,
#   merged_filename, app_audio_filename, mic_audio_filename, title
SESSION_SELECT="
$GROUP_CTE
SELECT
  lower(hex(s.id)),
  s.dateCreated,
  $DURATION_EXPR,
  COALESCE((SELECT filename FROM mediafile WHERE sessionID = s.id AND type = 'mergedMultitrack' LIMIT 1), ''),
  COALESCE((SELECT filename FROM mediafile WHERE sessionID = s.id AND type = 'meetingAppAudio' LIMIT 1), ''),
  COALESCE((SELECT filename FROM mediafile WHERE sessionID = s.id AND type = 'meetingMicAudio' LIMIT 1), ''),
  replace(replace(replace(
    COALESCE(s.userChosenTitle, s.aiTitle, rm.title, sar.title, 'Untitled'),
    char(9), ' '), char(10), ' '), char(13), ' ')
FROM session s
LEFT JOIN recordedmeeting rm ON rm.id = s.recordedMeetingID
LEFT JOIN systemaudiorecording sar ON sar.id = s.systemAudioRecordingID
LEFT JOIN grp g ON g.sid = lower(hex(s.id))
"
# Used by `latest`, date lookup and --list: the floor keeps accidental short
# clips from being auto-selected.
SESSION_QUERY="$SESSION_SELECT
WHERE $DURATION_EXPR > $MIN_DURATION_SECONDS
  AND $IS_GROUP_LEAD
ORDER BY s.dateCreated DESC
"
# Used by lookup by explicit session id: naming an id is unambiguous, so no
# duration heuristic applies (a real 4m14s huddle was unreachable, #37).
SESSION_QUERY_ANY="$SESSION_SELECT
ORDER BY s.dateCreated DESC
"
# Used by --all: the same floor as `latest`, minus sessions deleted inside
# MacWhisper (whose audio is usually gone too), oldest first so a batch
# reads in the order the meetings happened.
SESSION_QUERY_PENDING="$SESSION_SELECT
WHERE $DURATION_EXPR > $MIN_DURATION_SECONDS
  AND $IS_GROUP_LEAD
  AND s.dateDeleted IS NULL
ORDER BY s.dateCreated ASC
"

# Asks a y/N question and exits unless the answer is yes. A failed read means
# stdin hit end-of-file -- no terminal, as under launchd or a `!` shell escape,
# where bash also suppresses the -p prompt. Unguarded, `set -e` then ended the
# script at the read with exit 1 and no message at all.
confirm() {
  local reply
  if ! read -r -p "$1 [y/N] " reply; then
    echo >&2
    echo "Error: no answer to the confirmation prompt (stdin is closed or not a terminal). Re-run with --yes to skip it." >&2
    exit 1
  fi
  [[ "$reply" =~ ^[Yy]$ ]] || {
    echo "Aborted."
    exit 1
  }
}

slugify() {
  local slug
  slug=$(echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
  # A title that is empty, or made entirely of punctuation or non-ASCII
  # characters, reduces to "". That would produce an output basename of
  # "<date>_.md" -- a hidden dotfile that the user is unlikely to find.
  [[ -n "$slug" ]] || slug="untitled"
  echo "$slug"
}

fmt_duration() {
  local secs="${1:-0}"
  # Durations arrive from SQLite as either an integer or a float
  # ("1076" or "1076.5"); strip any fractional part before arithmetic,
  # since bash cannot do floating point. A non-numeric or empty value
  # would otherwise abort the script on an arithmetic syntax error.
  secs="${secs%.*}"
  [[ "$secs" =~ ^[0-9]+$ ]] || secs=0
  printf "%dm%02ds" "$((secs / 60))" "$((secs % 60))"
}

# Prefer merged multitrack, then app audio, then mic audio.
pick_source() {
  local f
  for f in "$@"; do
    if [[ -n "$f" ]]; then
      printf '%s\n' "$f"
      return 0
    fi
  done
  return 1
}

# $1's split-meeting group, oldest first, one "<sid>$SEP<start>$SEP<end>" line
# each, in milliseconds after the first piece began.
group_members() {
  local sid="$1" rows
  # sid is bare hex from lower(hex()), so it is safe to interpolate.
  if ! rows=$(sql "$GROUP_CTE SELECT g.sid,
      CAST(ROUND((g.t0 - l.t0) * 86400000) AS INTEGER),
      CAST(ROUND((r.t1 - l.t0) * 86400000) AS INTEGER)
    FROM grp g JOIN grp l ON l.sid = g.lead JOIN rec r ON r.sid = g.sid
    WHERE g.lead = (SELECT lead FROM grp WHERE sid = '$sid') ORDER BY g.t0, g.sid"); then
    echo "Error: failed to query MacWhisper database at $DB" >&2
    exit 1
  fi
  [[ -n "$rows" ]] || rows="$sid${SEP}0${SEP}0"
  printf '%s\n' "$rows"
}

# "<session id>$SEP<sidecar>" per session a sidecar holds (with "covered",
# also missing and pending). Bad sidecars are skipped.
sidecar_index() {
  local meta ids id filter='(.session_ids // [.session_id])'
  [[ "${1:-}" != "covered" ]] || filter+=' + (.missing_session_ids // []) + (.pending_session_ids // [])'
  shopt -s nullglob
  local metas=("$OUTPUT_DIR"/*.meta.json)
  shopt -u nullglob
  for meta in ${metas[@]+"${metas[@]}"}; do
    ids=$(jq -r "$filter | .[] | strings" "$meta" 2>/dev/null) || continue
    while IFS= read -r id; do
      [[ -z "$id" ]] || printf '%s%s%s\n' "$id" "$SEP" "$meta"
    done <<<"$ids"
  done
}

# First sidecar in index $1 naming any of the remaining session ids.
first_naming_sidecar() {
  local index="$1" id
  shift
  for id in "$@"; do
    awk -F"$SEP" -v id="$id" '$1 == id { print $2; found = 1; exit } END { exit !found }' <<<"$index" && return 0
  done
  return 1
}

# 0 when the sidecar index in $1 names every remaining session id.
all_named() {
  local index="$1" id
  shift
  for id in "$@"; do
    awk -F"$SEP" -v id="$id" '$1 == id { found = 1; exit } END { exit !found }' <<<"$index" || return 1
  done
}

# Seconds as mw prints a timestamp: MM:SS, or HH:MM:SS from one hour on.
fmt_clock() {
  local s="$1"
  if ((s >= 3600)); then
    printf '%02d:%02d:%02d' "$((s / 3600))" "$((s % 3600 / 60))" "$((s % 60))"
  else
    printf '%02d:%02d' "$((s / 60))" "$((s % 60))"
  fi
}

# mw transcript $1 on stdout with each *start-end* line moved $2 s later;
# every other line passes through unchanged.
offset_transcript() {
  awk -v off="$2" '
    function secs(t, p, n) {
      n = split(t, p, ":")
      return n == 3 ? p[1] * 3600 + p[2] * 60 + p[3] : p[1] * 60 + p[2]
    }
    function clock(s) {
      if (s >= 3600) return sprintf("%02d:%02d:%02d", int(s / 3600), int((s % 3600) / 60), s % 60)
      return sprintf("%02d:%02d", int(s / 60), s % 60)
    }
    /^\*[0-9:]+(-[0-9:]+)?\*$/ {
      n = split(substr($0, 2, length($0) - 2), ends, "-")
      out = clock(secs(ends[1]) + off)
      if (n == 2) out = out "-" clock(secs(ends[2]) + off)
      print "*" out "*"
      next
    }
    { print }
  ' "$1"
}

# Regenerates OUTPUT_DIR/_index.md from every *.meta.json sidecar present.
# Called only after a successful transcribe or --mark-reviewed -- never from
# --list or --dry-run, both of which are read-only paths.
#
# A sidecar is skipped, not fatal, when it fails to parse: one bad file must
# not stop the whole directory's index from being written, matching
# huddle-migrate-md's precedent for a corrupt sidecar (see its survey step).
write_index() {
  local index="$OUTPUT_DIR/_index.md"
  local sep=$'\x1f'

  # A literal-match glob, so an empty OUTPUT_DIR yields zero candidates
  # rather than the unexpanded pattern "*.meta.json" under set -e.
  shopt -s nullglob
  local metas=("$OUTPUT_DIR"/*.meta.json)
  shopt -u nullglob

  # Row fields are joined with $sep (0x1F), not a tab, for the same reason
  # SESSION_QUERY does: tab is IFS whitespace and would collapse if any
  # field were ever empty. title is read last so a stray control character
  # in a hand-edited sidecar truncates the title rather than displacing
  # output_file.
  local idx_rows=() meta line date dur reviewed output_file title
  for meta in ${metas[@]+"${metas[@]}"}; do
    # jq -r (not -e): -e treats a final false/null/empty-string value as
    # failure, which would misclassify a valid reviewed:false sidecar as
    # malformed. A genuinely unparseable file still makes jq exit nonzero.
    if ! line=$(jq -r --arg sep "$sep" \
      '[(.date // ""), (.duration_seconds // 0 | tostring), ((.reviewed // false) | tostring), (.output_file // ""), (.title // "")] | join($sep)' \
      "$meta" 2>/dev/null); then
      continue
    fi
    IFS="$sep" read -r date dur reviewed output_file title <<<"$line" || true
    # No output_file means no link is possible; the row would be useless.
    [[ -n "$output_file" ]] || continue

    if [[ -z "$title" ]]; then
      # Sidecars written before this field existed have no title. Fall back
      # to de-slugifying the basename: strip the YYYY-MM-DD_ prefix and the
      # _<8-hex-id>.md suffix, then turn dashes back into spaces. Minimal on
      # purpose -- this is a fallback, not a real de-slugify.
      local base slug
      base="${output_file##*/}"
      slug="${base#??????????_}"
      slug="${slug%_????????.md}"
      title="${slug//-/ }"
      [[ -n "$title" ]] || title="(untitled)"
    fi

    # A literal pipe in a free-text title would break the Markdown table.
    title="${title//|/\\|}"

    idx_rows+=("${date}${sep}${title}${sep}${dur}${sep}${reviewed}${sep}${output_file}")
  done

  local body=""
  if [[ ${#idx_rows[@]} -gt 0 ]]; then
    # Newest first, matching --list. Sorting the whole joined row works
    # because date is a fixed-width YYYY-MM-DD prefix and sorts first.
    local idx_sorted
    idx_sorted=$(printf '%s\n' "${idx_rows[@]}" | sort -r)
    while IFS="$sep" read -r date title dur reviewed output_file; do
      local pretty_dur reviewed_word
      pretty_dur=$(fmt_duration "$dur")
      if [[ "$reviewed" == "true" ]]; then
        reviewed_word="yes"
      else
        reviewed_word="no"
      fi
      body+=$(printf '| %s | %s | %s | %s | [%s](%s) |\n' \
        "$date" "$title" "$pretty_dur" "$reviewed_word" "$output_file" "$output_file")
      body+=$'\n'
    done <<<"$idx_sorted"
  fi

  # mktemp beside the target, same rationale as every other write in this
  # script: OUTPUT_DIR is frequently a synced Drive folder on another
  # filesystem than $TMPDIR, and a same-directory rename is atomic.
  #
  # This function is called as `write_index || ...` by both callers, which
  # suppresses `set -e` for everything inside this function body -- a
  # failing command here no longer aborts the script on its own. Every
  # fallible step below is therefore checked explicitly and the function
  # returns nonzero on the first failure, rather than relying on -e.
  local tmp
  tmp=$(mktemp "${index}.XXXXXX") || return 1
  if ! {
    echo "<!-- Generated by huddle-transcribe. Do not hand-edit; it is overwritten on every transcribe / --mark-reviewed run. -->"
    echo
    echo "| Date | Title | Duration | Reviewed | File |"
    echo "| --- | --- | --- | --- | --- |"
    if [[ ${#idx_rows[@]} -eq 0 ]]; then
      echo "_No transcripts yet._"
    else
      printf '%s' "$body"
    fi
  } >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if ! mv "$tmp" "$index"; then
    rm -f "$tmp"
    return 1
  fi
}

# --- --list ---
if [[ $LIST -eq 1 ]]; then
  rows=$(sql "$SESSION_QUERY LIMIT 10")
  if [[ -z "$rows" ]]; then
    echo "No qualifying sessions found (duration > ${MIN_DURATION_SECONDS}s)." >&2
    exit 1
  fi
  printf "%-8s  %-19s  %-8s  %s\n" "SESSION" "DATE" "DURATION" "TITLE"
  while IFS="$SEP" read -r sid date dur _merged _app _mic title; do
    pretty_dur=$(fmt_duration "$dur")
    printf "%-8s  %-19s  %-8s  %s\n" "${sid:0:8}" "${date%.*}" "$pretty_dur" "$title"
  done <<<"$rows"
  exit 0
fi

# --- --all ---
# "Not yet transcribed" means no sidecar for the session in OUTPUT_DIR, found
# by the same id-suffix glob --mark-reviewed uses -- the sidecar is the state,
# and a title that changed since transcription must not make a session look
# pending again. Each session is then transcribed by a child invocation of
# this same script with an explicit id, so the batch reuses the single-session
# path, guards and all, rather than duplicating it.
if [[ $ALL -eq 1 ]]; then
  if ! all_rows=$(sql "$SESSION_QUERY_PENDING"); then
    echo "Error: failed to query MacWhisper database at $DB" >&2
    exit 1
  fi
  pending=()
  # Rows are group leads only. A split meeting is done once sidecars name
  # every piece.
  if ! group_pairs=$(sql "$GROUP_CTE SELECT lead, sid FROM grp WHERE n > 1"); then
    echo "Error: failed to query MacWhisper database at $DB" >&2
    exit 1
  fi
  # A part the watcher left missing or pending counts: retrying it is its job.
  named_index=$(sidecar_index covered)
  if [[ -n "$all_rows" ]]; then
    while IFS="$SEP" read -r sid date dur _merged _app _mic title; do
      members=$(awk -F"$SEP" -v lead="$sid" '$1 == lead { print $2 }' <<<"$group_pairs")
      if [[ -z "$members" ]]; then
        shopt -s nullglob
        id_matches=("$OUTPUT_DIR"/*_"${sid:0:8}".meta.json)
        shopt -u nullglob
        [[ ${#id_matches[@]} -eq 0 ]] || continue
        first_naming_sidecar "$named_index" "$sid" >/dev/null && continue
      else
        read -r -d '' -a member_list <<<"$members" || true
        all_named "$named_index" "${member_list[@]}" && continue
      fi
      if [[ ${#pending[@]} -eq 0 ]]; then
        printf "%-8s  %-19s  %-8s  %s\n" "SESSION" "DATE" "DURATION" "TITLE"
      fi
      pending+=("$sid")
      pretty_dur=$(fmt_duration "$dur")
      printf "%-8s  %-19s  %-8s  %s\n" "${sid:0:8}" "${date%.*}" "$pretty_dur" "$title"
    done <<<"$all_rows"
  fi
  if [[ ${#pending[@]} -eq 0 ]]; then
    echo "Nothing to transcribe: every qualifying session (duration > ${MIN_DURATION_SECONDS}s) has a sidecar in $OUTPUT_DIR."
    exit 0
  fi
  if [[ $DRY_RUN -eq 1 ]]; then
    echo "(dry run — would transcribe ${#pending[@]} session(s))"
    exit 0
  fi
  if [[ $ASSUME_YES -ne 1 ]]; then
    confirm "Transcribe these ${#pending[@]} session(s)?"
  fi
  # One failure does not stop the batch: the remaining sessions are
  # independent, and the summary names every failure so none is lost.
  failed=()
  n=0
  for sid in "${pending[@]}"; do
    n=$((n + 1))
    echo
    echo "[$n/${#pending[@]}] ${sid:0:8}"
    if ! "${BASH_SOURCE[0]}" --yes --output-dir "$OUTPUT_DIR" "$sid"; then
      failed+=("${sid:0:8}")
    fi
  done
  echo
  echo "Transcribed $((${#pending[@]} - ${#failed[@]})) of ${#pending[@]} session(s)."
  if [[ ${#failed[@]} -gt 0 ]]; then
    echo "Failed: ${failed[*]}" >&2
    exit 1
  fi
  exit 0
fi

# --- session selection ---
find_session_by_date() {
  local target_date="$1"
  # Validate the date is real, not merely well-shaped -- the caller's regex
  # only checks the digit pattern, so 2026-02-30 and 2026-13-01 reach here.
  # Done in pure bash rather than with date(1): `date -j` is BSD-only and
  # `date -d` is GNU-only, so either choice breaks on the other platform,
  # and BSD date silently ROLLS an out-of-range day (2026-02-30 becomes
  # 2026-03-02, exit 0) which makes it a poor validator regardless.
  local y="${target_date:0:4}" mo="${target_date:5:2}" d="${target_date:8:2}"
  # 10# forces base 10: a leading zero would otherwise be read as octal,
  # making 08 and 09 arithmetic errors.
  y=$((10#$y))
  mo=$((10#$mo))
  d=$((10#$d))
  local days_in_month=31
  case "$mo" in
    4 | 6 | 9 | 11) days_in_month=30 ;;
    2)
      days_in_month=28
      if ((y % 4 == 0 && (y % 100 != 0 || y % 400 == 0))); then
        days_in_month=29
      fi
      ;;
    *) ;; # 31-day months and out-of-range values; the bounds check follows
  esac
  if ((mo < 1 || mo > 12 || d < 1 || d > days_in_month)); then
    echo "Error: invalid date '$target_date' (expected a real YYYY-MM-DD)" >&2
    exit 1
  fi

  # Match on the stored calendar date, not on a distance between timestamps.
  # The previous version anchored the target at 08:00 America/Los_Angeles
  # but parsed row timestamps as UTC, so the comparison mixed two zones and
  # a 16h half-width window spanned 32h -- a session stored at 00:30 on the
  # 27th matched BOTH the 26th and the 27th. Comparing the date prefix is
  # exact, timezone-agnostic, needs no window, and matches what --list
  # prints, which is what a user is reading when they type a date.
  local matches=0 best_sid="" all_rows
  # Collect first, then loop over the result. Piping sql directly into the
  # loop would mask its exit status (SC2312), and a process substitution
  # cannot report a failed query at all -- an unreadable or corrupt
  # database would silently look like "no sessions found".
  if ! all_rows=$(sql "$SESSION_QUERY"); then
    echo "Error: failed to query MacWhisper database at $DB" >&2
    exit 1
  fi
  [[ -n "$all_rows" ]] || return 0
  # Rows arrive newest-first, so the first match on a day is that day's
  # latest session.
  while IFS="$SEP" read -r sid date _dur _merged _app _mic _title; do
    [[ "${date%% *}" == "$target_date" ]] || continue
    matches=$((matches + 1))
    [[ -n "$best_sid" ]] || best_sid="$sid"
  done <<<"$all_rows"

  if [[ -z "$best_sid" ]]; then
    echo "Error: no qualifying session on $target_date (duration > ${MIN_DURATION_SECONDS}s; an explicit session id bypasses that). Try --list." >&2
    return 1
  fi
  if ((matches > 1)); then
    echo "Note: $matches sessions on $target_date; using the most recent (${best_sid:0:8}). Pass a session id to pick another." >&2
  fi
  # best_sid is a bare hex session id (no delimiters), safe to re-look-up
  # cleanly rather than round-tripping title/filename fields through a
  # delimiter that could appear in a session title.
  find_session_by_id "$best_sid"
}

find_session_by_id() {
  local partial="$1"
  # Session ids are selected as lower(hex(s.id)) -- bare hex, no dashes.
  # A UUID copied out of MacWhisper's own UI is dashed, so strip dashes
  # before matching or such an id never matches anything.
  partial="${partial//-/}"
  if [[ -z "$partial" ]]; then
    echo "Error: empty session id" >&2
    exit 1
  fi
  if ! [[ "$partial" =~ ^[0-9a-fA-F]+$ ]]; then
    echo "Error: '$1' is not a session id (expected hex, or a YYYY-MM-DD date). Try --list." >&2
    exit 1
  fi
  # Check the query separately rather than piping it straight into awk: a
  # pipeline masks sqlite3's exit status, so an unreadable or corrupt
  # database reported "no such session" instead of naming the real problem.
  local all_rows
  if ! all_rows=$(sql "$SESSION_QUERY_ANY"); then
    echo "Error: failed to query MacWhisper database at $DB" >&2
    exit 1
  fi
  # Split on $SEP, matching the rest of the script. With -F'\t' there are no
  # tabs in the row, so $1 would be the entire line and the prefix match
  # would work only because the id happens to sit first -- correct today,
  # but silently wrong after any column reorder.
  local hits
  hits=$(awk -F"$SEP" -v id="$partial" 'index(tolower($1), tolower(id)) == 1' <<<"$all_rows")
  [[ -n "$hits" ]] || return 1
  # An ambiguous prefix must not resolve silently: --mark-reviewed removes
  # audio, and "here is my guess" is the wrong default for that.
  local hit_count
  hit_count=$(grep -c . <<<"$hits")
  if ((hit_count > 1)); then
    echo "Error: session id '$1' is ambiguous; it matches:" >&2
    awk -F"$SEP" '{printf "  %s  %s  %s\n", $1, $2, $7}' <<<"$hits" >&2
    echo "Pass more characters of the id." >&2
    # Exit 3, not 1: the caller uses this to tell "already explained the
    # problem in detail" apart from a plain no-match, and suppress its own
    # generic message.
    exit 3
  fi
  printf '%s\n' "$hits"
}

find_latest_session() {
  local row
  # Same reasoning as find_session_by_id: report a query failure as one
  # rather than letting it look like an empty database.
  if ! row=$(sql "$SESSION_QUERY LIMIT 1"); then
    echo "Error: failed to query MacWhisper database at $DB" >&2
    exit 1
  fi
  [[ -n "$row" ]] || return 1
  printf '%s\n' "$row"
}

# These helpers end in a conditional whose false branch returns 1, and an
# unguarded assignment under `set -e` would abort here silently. Guard each
# one, but track whether the helper already explained itself: find_session_
# by_date prints a specific reason ("no session on <date>"), and following
# that with the generic message below is just noise.
SELECTED=""
selection_explained=0
if [[ -z "$TARGET" || "$TARGET" == "latest" ]]; then
  SELECTED=$(find_latest_session) || true
elif [[ "$TARGET" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  SELECTED=$(find_session_by_date "$TARGET") || selection_explained=1
else
  SELECTED=$(find_session_by_id "$TARGET") || [[ $? -ne 3 ]] || selection_explained=1
fi

if [[ -z "$SELECTED" ]]; then
  if [[ $selection_explained -eq 0 ]]; then
    echo "Error: no qualifying session found for '$TARGET'. Try --list." >&2
  fi
  exit 1
fi

# STITLE is read last so it absorbs any remaining tabs rather than shifting
# the filename columns. `read` returns nonzero on a final line with no
# trailing newline, which `set -e` would treat as fatal, hence `|| true`.
IFS="$SEP" read -r SID SDATE SDUR SMERGED SAPP SMIC STITLE <<<"$SELECTED" || true

# A split meeting is one transcript, named after its first recording.
REQ_SID="$SID"
group_rows=$(group_members "$SID")
GROUP_IDS=()
GROUP_START=()
GROUP_END=()
while IFS="$SEP" read -r m m_start m_end; do
  [[ -n "$m" ]] || continue
  GROUP_IDS+=("$m")
  GROUP_START+=("${m_start:-0}")
  GROUP_END+=("${m_end:-0}")
done <<<"$group_rows"
STITCH=0
if [[ ${#GROUP_IDS[@]} -gt 1 ]]; then
  STITCH=1
  if [[ "${GROUP_IDS[0]}" != "$SID" ]]; then
    if ! lead_row=$(find_session_by_id "${GROUP_IDS[0]}"); then
      echo "Error: cannot resolve ${GROUP_IDS[0]:0:8}, the first recording of the meeting ${SID:0:8} belongs to." >&2
      exit 1
    fi
    IFS="$SEP" read -r SID SDATE SDUR SMERGED SAPP SMIC STITLE <<<"$lead_row" || true
    echo "Note: ${REQ_SID:0:8} is one of ${#GROUP_IDS[@]} recordings of one meeting; using the first, ${SID:0:8}." >&2
  fi
fi

# Each member's start, gap and audio. One not ready (--pending, or no audio
# row) and not cached is pending: left out, named at the end.
PART_IDS=()
PART_FILES=()
PART_START=()
PART_GAP=()
PART_POS=()
PEND_IDS=()
PEND_POS=()
PEND_START=()
M_SRC=()
M_GAP=()
prev_end=""
for i in "${!GROUP_IDS[@]}"; do
  m="${GROUP_IDS[i]}"
  m_file=""
  if member_row=$(find_session_by_id "$m" 2>/dev/null); then
    IFS="$SEP" read -r _ _ _ m_merged m_app m_mic _ <<<"$member_row" || true
    m_file=$(pick_source "$m_merged" "$m_app" "$m_mic") || m_file=""
  fi
  # Rounded from milliseconds once, so a gap is not off by a rounding of each end.
  gap=0
  [[ -z "$prev_end" ]] || gap=$(((GROUP_START[i] - prev_end + 500) / 1000))
  ((gap >= 0)) || gap=0
  if [[ -z "$prev_end" ]] || ((GROUP_END[i] > prev_end)); then
    prev_end="${GROUP_END[i]}"
  fi
  M_GAP+=("$gap")
  m_pending=0
  if [[ $STITCH -eq 1 && ! -s "$PIECES_DIR/$m.md" ]]; then
    # MacWhisper adds the audio row when it saves the recording.
    [[ -n "$m_file" ]] || m_pending=1
    for pend_arg in ${PENDING_ARGS[@]+"${PENDING_ARGS[@]}"}; do
      [[ "$m" != "$pend_arg"* ]] || m_pending=1
    done
  fi
  if [[ $m_pending -eq 1 ]]; then
    echo "Note: ${m:0:8}, recording $((i + 1)) of ${#GROUP_IDS[@]} of this meeting, is not ready yet; it is left out." >&2
    echo "Part pending: $m"
    PEND_IDS+=("$m")
    PEND_POS+=("$((i + 1))")
    PEND_START+=("$(((GROUP_START[i] + 500) / 1000))")
    M_SRC+=("(not ready yet; left out)")
    continue
  fi
  PART_IDS+=("$m")
  PART_FILES+=("$m_file")
  PART_START+=("$(((GROUP_START[i] + 500) / 1000))")
  PART_GAP+=("$gap")
  PART_POS+=("$((i + 1))")
  if [[ -n "$m_file" ]]; then
    M_SRC+=("$MEDIA_DIR/$m_file")
  else
    M_SRC+=("(no saved audio)")
  fi
done
if [[ ${#PART_IDS[@]} -eq 0 && $MARK_REVIEWED -eq 0 ]]; then
  echo "Error: no recording of the meeting ${SID:0:8} is ready yet." >&2
  exit 1
fi
# Each part is transcribed alone and the transcripts are joined: mw on
# ffmpeg-joined audio lost all capitalization and punctuation.
PIECES=0
if [[ $STITCH -eq 1 || $RESTITCH -eq 1 ]]; then
  PIECES=1
fi

# Prefer merged multitrack, then app audio, then mic audio. A split
# meeting's first recording may not be ready yet; its parts carry the audio.
SOURCE_FILENAME=""
if [[ -n "$SMERGED" ]]; then
  SOURCE_FILENAME="$SMERGED"
elif [[ -n "$SAPP" ]]; then
  SOURCE_FILENAME="$SAPP"
elif [[ -n "$SMIC" ]]; then
  SOURCE_FILENAME="$SMIC"
elif [[ $STITCH -eq 0 ]]; then
  echo "Error: session $SID has no usable audio file." >&2
  exit 1
fi

SOURCE_PATH="$MEDIA_DIR/$SOURCE_FILENAME"
SESSION_DATE_ONLY="${SDATE%% *}"
if ! [[ "$SESSION_DATE_ONLY" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  echo "Error: unexpected session date format '$SDATE'" >&2
  exit 1
fi
SLUG=$(slugify "$STITLE")
# The session id prefix disambiguates two sessions on the same date whose
# titles slugify identically ("SRE Daily Huddle" and "SRE/Daily Huddle"
# both become "sre-daily-huddle"). Without it the second transcribe
# silently overwrote the first, and --mark-reviewed could then delete the
# audio of a session whose transcript had already been replaced.
OUT_BASENAME="${SESSION_DATE_ONLY}_${SLUG}_${SID:0:8}"
# Markdown, not plain text, because the transcripts are read in Google Drive's
# web viewer, which previews .md inline but offers only a download prompt for
# .txt. The content difference from `--format txt` is one thing -- mw wraps the
# timestamp line in asterisks -- so the extension, not the markup, is the point.
# Crucially the four-line block structure (label / timestamp / body / blank) is
# byte-identical either way, which is what keeps the line-anchored rewrite in
# docs/plans/speaker-name-attribution.md valid. `--format html` would not: mw
# emits that as a single unbroken line for the entire transcript body.
OUT_DOC="$OUTPUT_DIR/${OUT_BASENAME}.md"
OUT_META="$OUTPUT_DIR/${OUT_BASENAME}.meta.json"

# --mark-reviewed acts on a sidecar written by an earlier run, so it must find
# that file rather than the name today's title would produce. MacWhisper keeps
# titling a session after its transcript is written -- a session captured as
# "Untitled" is routinely named minutes later -- and the derived basename then
# points at a file that never existed, stranding the audio forever.
#
# Resolve by the session id suffix instead, which is the stable part of the
# name. This is the primary lookup, not a fallback: the glob also matches the
# derived path whenever the title has not changed, so there is one code path.
# Two sidecars can share an 8-hex-char suffix, so an ambiguous match refuses
# rather than guesses; the session_id equality check below is what ultimately
# authorizes the delete, and it still runs on whatever the glob resolved.
if [[ $MARK_REVIEWED -eq 1 ]]; then
  shopt -s nullglob
  id_matches=("$OUTPUT_DIR"/*_"${SID:0:8}".meta.json)
  shopt -u nullglob
  # In a split meeting, use the sidecar(s) that name the session asked for.
  if [[ $STITCH -eq 1 ]]; then
    id_matches=()
    naming=$(sidecar_index | awk -F"$SEP" -v id="$REQ_SID" '$1 == id { print $2 }')
    while IFS= read -r meta; do
      [[ -z "$meta" ]] || id_matches+=("$meta")
    done <<<"$naming"
  fi
  if [[ ${#id_matches[@]} -gt 1 ]]; then
    echo "Error: ${#id_matches[@]} sidecars in $OUTPUT_DIR name session ${REQ_SID:0:8}:" >&2
    per_piece=0
    for meta in "${id_matches[@]}"; do
      meta_desc=$(jq -r '"\(.output_file // "?"), holds \((.session_ids // [.session_id]) | map(.[0:8]) | join(" "))"
        + (if has("session_ids") then "" else " (a per-recording transcript)" end)
        + (if .reviewed == true then ", reviewed" else "" end)' "$meta" 2>/dev/null) || meta_desc="unreadable"
      [[ "$meta_desc" != *"(a per-recording transcript)"* ]] || per_piece=$((per_piece + 1))
      printf '  %s\n    %s\n' "$(basename "$meta")" "$meta_desc" >&2
    done
    echo "Refusing to delete source audio: each would release audio the other still points at." >&2
    if [[ $per_piece -gt 0 && $per_piece -lt ${#id_matches[@]} ]]; then
      echo "A per-recording transcript from before stitching and a stitched one both hold this recording." >&2
      echo "To release every recording through the stitched one, move each per-recording .md and .meta.json pair" >&2
      echo "out of $OUTPUT_DIR (check no KB note's source: names it), then re-run; to release only this" >&2
      echo "recording, move the stitched pair out instead." >&2
    else
      echo "Keep the transcript you reviewed: move the other .md and .meta.json pair out of $OUTPUT_DIR, then re-run." >&2
    fi
    exit 1
  fi
  if [[ ${#id_matches[@]} -eq 1 ]]; then
    OUT_META="${id_matches[0]}"
    # The sidecar names its own transcript. Deriving it from the sidecar's
    # basename would work today but re-encodes the naming scheme in a second
    # place; output_file is the field the write path already records, and the
    # -s guard below depends on this pointing at the real transcript.
    meta_output_file=$(jq -r '.output_file // empty' "$OUT_META" 2>/dev/null || true)
    if [[ -n "$meta_output_file" ]]; then
      OUT_DOC="$OUTPUT_DIR/$meta_output_file"
    fi
  fi
fi

# --skip-existing: a session that already has its sidecar is done. Checked
# before the source-audio test below, because a reviewed session's audio is
# gone by design and must read as finished, not as an error. The same
# id-suffix glob and session_id equality as --mark-reviewed, so a sidecar
# that merely shares the 8-hex suffix does not count.
if [[ $SKIP_EXISTING -eq 1 ]]; then
  if [[ $STITCH -eq 0 ]]; then
    shopt -s nullglob
    id_matches=("$OUTPUT_DIR"/*_"${SID:0:8}".meta.json)
    shopt -u nullglob
    for meta in ${id_matches[@]+"${id_matches[@]}"}; do
      meta_session_id=$(jq -r '.session_id // empty' "$meta" 2>/dev/null || true)
      if [[ "$meta_session_id" == "$SID" ]]; then
        echo "Already transcribed: $meta"
        exit 0
      fi
    done
  fi
  # Done once sidecars name EVERY part. By hand, a missing or pending part
  # counts as named: retrying it is the watcher's job.
  if [[ $RESTITCH -eq 1 ]]; then
    named_index=$(sidecar_index)
  else
    named_index=$(sidecar_index covered)
  fi
  if all_named "$named_index" "${PART_IDS[@]}"; then
    meta=$(first_naming_sidecar "$named_index" "${PART_IDS[@]}")
    echo "Already transcribed: $meta"
    exit 0
  fi
fi

# sha256 of file $1, or failure. Ties a replaceable sidecar to the exact doc it wrote.
doc_sha256() {
  local out
  out=$(shasum -a 256 <"$1" 2>/dev/null) || return 1
  out="${out%% *}"
  [[ "$out" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$out"
}

# 0 while OUT_META is unreviewed and OUT_DOC is the doc the watcher wrote.
still_replaceable() {
  local now
  jq -e '(.reviewed != true) and (.deleted_source != true)' "$OUT_META" >/dev/null 2>&1 || return 1
  now=$(doc_sha256 "$OUT_DOC") || return 1
  [[ "$now" == "$REPLACE_HASH" ]]
}

# Points OUT_* at the next free <date>_<slug>-N_<id>; N goes before the id,
# which every *_<id>.meta.json lookup needs.
take_next_free_name() {
  local dup_n=2
  while [[ -e "$OUTPUT_DIR/${SESSION_DATE_ONLY}_${SLUG}-${dup_n}_${SID:0:8}.md" ||
    -e "$OUTPUT_DIR/${SESSION_DATE_ONLY}_${SLUG}-${dup_n}_${SID:0:8}.meta.json" ]]; do
    dup_n=$((dup_n + 1))
  done
  OUT_BASENAME="${SESSION_DATE_ONLY}_${SLUG}-${dup_n}_${SID:0:8}"
  OUT_DOC="$OUTPUT_DIR/${OUT_BASENAME}.md"
  OUT_META="$OUTPUT_DIR/${OUT_BASENAME}.meta.json"
}

# --restitch may replace one unreviewed, unedited transcript an earlier
# --restitch run wrote for this meeting only.
REPLACING=0
REPLACE_HASH=""
DUP_OF=""
if [[ $RESTITCH -eq 1 ]]; then
  replace_metas=()
  own_metas=$(awk -F"$SEP" 'NR == FNR { want[$1] = 1; next } ($1 in want) && !seen[$2]++ { print $2 }' \
    <(printf '%s\n' "${PART_IDS[@]}") <(printf '%s\n' "$named_index"))
  while IFS= read -r meta; do
    [[ -n "$meta" ]] || continue
    if jq -e '(.restitchable == true) and (.reviewed != true) and (.deleted_source != true)
      and ((.output_file // "") | test("^[^/]+[.]md$"))
      and ((.doc_sha256 // "") | test("^[0-9a-f]{64}$"))
      and ((((.session_ids // [.session_id]) + (.missing_session_ids // [])
        + (.pending_session_ids // [])) - $ARGS.positional) == [])' \
      "$meta" --args "${GROUP_IDS[@]}" >/dev/null 2>&1; then
      cand_doc="$OUTPUT_DIR/$(jq -r '.output_file' "$meta")"
      cand_hash=$(jq -r '.doc_sha256' "$meta")
      if [[ "$(doc_sha256 "$cand_doc" || true)" == "$cand_hash" ]]; then
        replace_metas+=("$meta")
      else
        echo "Note: $(basename "$cand_doc") changed since huddle-watch wrote it; it is kept." >&2
      fi
    fi
  done <<<"$own_metas"
  if [[ ${#replace_metas[@]} -eq 1 ]]; then
    REPLACING=1
    OUT_META="${replace_metas[0]}"
    OUT_DOC="$OUTPUT_DIR/$(jq -r '.output_file' "$OUT_META")"
    REPLACE_HASH=$(jq -r '.doc_sha256' "$OUT_META")
    DUP_OF=$(jq -r '.may_duplicate // empty' "$OUT_META" 2>/dev/null || true)
    echo "Note: replacing $(basename "$OUT_DOC"), this meeting's earlier unreviewed transcript, now with ${#PART_IDS[@]} part(s)." >&2
  elif [[ ${#replace_metas[@]} -gt 1 ]]; then
    echo "Note: ${#replace_metas[@]} transcripts of this meeting could be replaced; writing a new one instead." >&2
  fi
fi

# Never overwrite a transcript: take the next free <date>_<slug>-N_<id>.
if [[ $MARK_REVIEWED -ne 1 && $REPLACING -eq 0 ]]; then
  if [[ -e "$OUT_DOC" || -e "$OUT_META" ]]; then
    DUP_OF=$(basename "$OUT_DOC")
    take_next_free_name
    echo "Note: $DUP_OF already exists; writing $(basename "$OUT_DOC") instead." >&2
  else
    # The same session under an older title, or a per-piece transcript.
    dup_index=$(sidecar_index)
    if dup_meta=$(first_naming_sidecar "$dup_index" "${PART_IDS[@]}"); then
      DUP_OF=$(jq -r '.output_file // empty' "$dup_meta" 2>/dev/null || true)
      [[ -n "$DUP_OF" ]] || DUP_OF=$(basename "$dup_meta")
      echo "Note: this session already has a transcript, $DUP_OF; writing a second one." >&2
    fi
  fi
fi

echo "Session:  ${SID:0:8}"
echo "Date:     $SDATE"
SDUR_PRETTY=$(fmt_duration "$SDUR")
echo "Duration: $SDUR_PRETTY"
echo "Title:    $STITLE"
if [[ $STITCH -eq 1 ]]; then
  member_shorts=()
  for m in ${PART_IDS[@]+"${PART_IDS[@]}"}; do
    member_shorts+=("${m:0:8}")
  done
  if [[ ${#PEND_IDS[@]} -eq 0 ]]; then
    echo "Stitched: ${#PART_IDS[@]} recordings of one meeting (${member_shorts[*]})"
  else
    echo "Stitched: ${#PART_IDS[@]} of ${#GROUP_IDS[@]} recordings of one meeting (${member_shorts[*]-}); the rest are not ready yet"
  fi
  # One line per recording, so the watcher log records every stitch decision.
  for i in "${!GROUP_IDS[@]}"; do
    part_at="starts at $(fmt_clock "$(((GROUP_START[i] + 500) / 1000))")"
    ((i == 0)) || part_at+=", after a ${M_GAP[i]} s gap"
    echo "Part $((i + 1)):   ${GROUP_IDS[i]:0:8} $part_at: ${M_SRC[i]}"
  done
else
  echo "Source:   $SOURCE_PATH"
fi
echo "Output:   $OUT_DOC"

if [[ $MARK_REVIEWED -ne 1 && $PIECES -eq 0 && ! -f "$SOURCE_PATH" ]]; then
  echo "Error: source audio file not found at $SOURCE_PATH" >&2
  exit 1
fi

# --mark-reviewed removes the audio of every session the sidecar names,
# matched by exact id, never by prefix.
resolve_delete_paths() {
  local ids id row r_id r_merged r_app r_mic f
  DEL_PATHS=()
  DEL_IDS=()
  ids=$(jq -r '(.session_ids // [.session_id]) | .[] | strings' "$OUT_META" 2>/dev/null) || return 1
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    DEL_IDS+=("$id")
    if [[ "$id" == "$SID" && -n "$SOURCE_FILENAME" ]]; then
      DEL_PATHS+=("$SOURCE_PATH")
      continue
    fi
    row=$(find_session_by_id "$id" 2>/dev/null) || return 1
    IFS="$SEP" read -r r_id _ _ r_merged r_app r_mic _ <<<"$row" || true
    [[ "$r_id" == "$id" ]] || return 1
    f=$(pick_source "$r_merged" "$r_app" "$r_mic") || return 1
    DEL_PATHS+=("$MEDIA_DIR/$f")
  done <<<"$ids"
  [[ ${#DEL_PATHS[@]} -gt 0 ]]
}
DEL_PATHS=("$SOURCE_PATH")
DEL_IDS=()

# The cached piece transcripts of the recordings a review releases.
released_caches() {
  local id
  for id in ${DEL_IDS[@]+"${DEL_IDS[@]}"}; do
    [[ ! -e "$PIECES_DIR/$id.md" ]] || printf '%s\n' "$PIECES_DIR/$id.md"
  done
}

# --dry-run is checked before --mark-reviewed, and must stay that way.
# --dry-run is the flag a user reaches for when they are unsure what will be
# selected; combining it with --mark-reviewed previously deleted the audio
# anyway, because the deletion block ran first.
if [[ $DRY_RUN -eq 1 ]]; then
  if [[ $MARK_REVIEWED -eq 1 ]]; then
    if [[ ! -f "$OUT_META" ]] || ! resolve_delete_paths; then
      DEL_PATHS=("$SOURCE_PATH")
      DEL_IDS=()
    fi
    if [[ ${#DEL_PATHS[@]} -gt 1 ]]; then
      echo "(dry run — would mark reviewed and delete ${#DEL_PATHS[@]} files:)"
      printf '  %s\n' "${DEL_PATHS[@]}"
    else
      echo "(dry run — would mark reviewed and delete ${DEL_PATHS[0]})"
    fi
    caches=$(released_caches)
    if [[ -n "$caches" ]]; then
      echo "(and its cached piece transcripts:)"
      while IFS= read -r cache; do
        printf '  %s\n' "$cache"
      done <<<"$caches"
    fi
  else
    echo "(dry run — no transcription performed)"
  fi
  exit 0
fi

# --- --mark-reviewed ---
if [[ $MARK_REVIEWED -eq 1 ]]; then
  if [[ ! -f "$OUT_META" ]]; then
    echo "Error: no metadata sidecar found at $OUT_META. Transcribe first." >&2
    exit 1
  fi
  # The sidecar is located by session id suffix (see above), which is an
  # 8-hex-char prefix of a longer id and so is not by itself proof of identity.
  # Confirm it actually describes the session just resolved before deleting
  # anything: a same-day or suffix-colliding session could otherwise map onto a
  # sidecar belonging to a different recording.
  meta_session_id=$(jq -r '.session_id // empty' "$OUT_META" 2>/dev/null || true)
  if [[ -z "$meta_session_id" ]]; then
    echo "Error: $OUT_META is missing a session_id. Refusing to delete source audio." >&2
    exit 1
  fi
  # A stitched sidecar also counts when its session_ids names the session.
  if [[ "$meta_session_id" != "$REQ_SID" ]] &&
    ! jq -e --arg id "$REQ_SID" '(.session_ids // []) | any(.[]; . == $id)' "$OUT_META" >/dev/null 2>&1; then
    echo "Error: sidecar $OUT_META describes session ${meta_session_id:0:8}, but the selected session is ${REQ_SID:0:8}." >&2
    echo "Refusing to delete source audio. Pass the session id explicitly to disambiguate." >&2
    exit 1
  fi
  if ! resolve_delete_paths; then
    echo "Error: cannot resolve the source audio of every session $OUT_META names. Refusing to delete source audio." >&2
    exit 1
  fi
  # Deletion is irreversible and the transcript is the only thing that
  # survives it, so require that the transcript exists and is non-empty.
  if [[ ! -s "$OUT_DOC" ]]; then
    echo "Error: transcript $OUT_DOC is missing or empty. Refusing to delete source audio." >&2
    exit 1
  fi
  if [[ $ASSUME_YES -ne 1 ]]; then
    if command -v trash >/dev/null 2>&1; then
      delete_verb="move to Trash"
    else
      delete_verb="permanently delete"
    fi
    if [[ ${#DEL_PATHS[@]} -gt 1 ]]; then
      confirm "Mark reviewed and $delete_verb ${#DEL_PATHS[@]} source .m4a files (${DEL_PATHS[*]})?"
    else
      confirm "Mark reviewed and $delete_verb source .m4a (${DEL_PATHS[0]})?"
    fi
  fi
  # Order matters, and both obvious orderings are wrong:
  #
  #   record then delete -> a failed delete leaves the sidecar claiming a
  #                         deletion that never happened;
  #   delete then record -> a failed sidecar write leaves the audio gone
  #                         while the sidecar still says deleted_source:false.
  #
  # So split the write. Build the updated sidecar into a temp file FIRST --
  # that is the fallible part (jq missing, ENOSPC, permissions) and it
  # touches nothing real. Then delete the audio. Then rename the temp file
  # into place; a same-directory rename is atomic and essentially cannot
  # fail once the temp file exists. That leaves no window in which the
  # sidecar and the filesystem disagree.
  #
  # mktemp beside the sidecar, not in $TMPDIR: rename is only atomic within
  # one filesystem, and $TMPDIR is frequently on another one when
  # OUTPUT_DIR points at an external or synced volume.
  tmp=$(mktemp "${OUT_META}.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  if ! jq '.reviewed = true | .deleted_source = true' "$OUT_META" >"$tmp" || [[ ! -s "$tmp" ]]; then
    echo "Error: failed to prepare metadata sidecar $OUT_META. Source audio left in place." >&2
    exit 1
  fi

  # Prefer trash(1) (macOS 14+) so a mistake is recoverable from Finder.
  # This is the only irreversible step in the script, and the guards above
  # are the sole protection once the audio is really gone.
  sources_present=0
  # One path per recording the sidecar names; a re-run skips files already gone.
  for del_path in "${DEL_PATHS[@]}"; do
    if [[ ! -f "$del_path" ]]; then
      :
    elif command -v trash >/dev/null 2>&1; then
      if ! trash "$del_path"; then
        echo "Error: failed to trash $del_path. Sidecar left unchanged." >&2
        exit 1
      fi
      sources_present=$((sources_present + 1))
    elif ! rm -f "$del_path"; then
      echo "Error: failed to delete $del_path. Sidecar left unchanged." >&2
      exit 1
    else
      sources_present=$((sources_present + 1))
    fi
    # Belt-and-braces for the trash(1) branch specifically: rm -f reports its
    # own failures, but trash can exit 0 without having moved the file.
    if [[ -e "$del_path" ]]; then
      echo "Error: $del_path still present after removal. Sidecar left unchanged." >&2
      exit 1
    fi
  done

  mv "$tmp" "$OUT_META"
  trap - EXIT
  # Released pieces leave the re-stitch cache too; exact paths, never a glob.
  caches=$(released_caches)
  while IFS= read -r cache; do
    [[ -z "$cache" ]] || rm -f "$cache" || echo "Warning: failed to remove cached piece $cache" >&2
  done <<<"$caches"
  # The mark-reviewed operation is already durably complete at this point;
  # a failure inside write_index (e.g. ENOSPC, permissions on a synced
  # Drive folder) must not be reported as this command having failed --
  # that would tell --mark-reviewed's caller (a human, or a script) the
  # operation didn't happen, when the sidecar update and audio removal
  # both already succeeded. The index is a convenience view, rebuilt on
  # every run, so a stale one self-heals next time.
  write_index || echo "Warning: failed to regenerate $OUTPUT_DIR/_index.md" >&2
  if [[ ${#DEL_PATHS[@]} -gt 1 ]]; then
    if [[ $sources_present -eq 0 ]]; then
      echo "Marked reviewed (source audio was already gone): ${#DEL_PATHS[@]} files"
    elif command -v trash >/dev/null 2>&1; then
      echo "Marked reviewed and moved $sources_present of ${#DEL_PATHS[@]} source files to Trash:"
    else
      echo "Marked reviewed and deleted $sources_present of ${#DEL_PATHS[@]} source files:"
    fi
    printf '  %s\n' "${DEL_PATHS[@]}"
  elif [[ $sources_present -eq 1 ]]; then
    if command -v trash >/dev/null 2>&1; then
      echo "Marked reviewed and moved source to Trash: ${DEL_PATHS[0]}"
    else
      echo "Marked reviewed and deleted source: ${DEL_PATHS[0]}"
    fi
  else
    echo "Marked reviewed (source audio was already gone): ${DEL_PATHS[0]}"
  fi
  exit 0
fi

if [[ $ASSUME_YES -ne 1 ]]; then
  confirm "Transcribe this session?"
fi

# mw with the repo's fixed flags: run_mw OUTPUT AUDIO.
run_mw() {
  "$MW_BIN" transcribe \
    --speakers \
    --speaker-names \
    --timestamps \
    --end-timestamps \
    --format md \
    --overwrite \
    -o "$1" \
    "$2"
}

# Transcribe to a temp path and move into place only once mw has succeeded
# and produced a non-empty file. Writing straight to $OUT_DOC means an
# interrupted or failed run (Ctrl-C, crash, full disk) destroys a previously
# good transcript, since mw is invoked with --overwrite.
DOC_TMP=$(mktemp "${OUT_DOC}.partial.XXXXXX")
trap 'rm -f "$DOC_TMP"' EXIT
PART_OK=()
PART_WHY=()
if [[ $PIECES -eq 0 ]]; then
  if ! run_mw "$DOC_TMP" "$SOURCE_PATH"; then
    echo "Error: mw transcribe failed for $SOURCE_PATH" >&2
    # No sidecar is written on failure. That is deliberate: --mark-reviewed
    # refuses to run without one, so a failed transcription can never lead to
    # the source audio being deleted.
    exit 1
  fi
else
  # Each part into the cache (temp beside it, then mv), unless --restitch
  # finds it there already or its audio is gone.
  parts_ok=0
  parts_new=0
  for i in "${!PART_IDS[@]}"; do
    m="${PART_IDS[i]}"
    cache="$PIECES_DIR/$m.md"
    audio=""
    [[ -z "${PART_FILES[i]}" ]] || audio="$MEDIA_DIR/${PART_FILES[i]}"
    why=""
    if [[ -s "$cache" ]] && [[ $RESTITCH -eq 1 || -z "$audio" || ! -f "$audio" ]]; then
      echo "Part cached: $m"
    elif [[ -z "$audio" ]]; then
      why="no saved audio"
    elif [[ ! -f "$audio" ]]; then
      why="audio file not found at $audio"
    elif ! mkdir -p "$PIECES_DIR" || ! piece_tmp=$(mktemp "$cache.partial.XXXXXX"); then
      why="cannot write to $PIECES_DIR"
    elif ! run_mw "$piece_tmp" "$audio" || [[ ! -s "$piece_tmp" ]] || ! mv "$piece_tmp" "$cache"; then
      rm -f "$piece_tmp"
      why="mw transcribe failed for $audio"
    else
      echo "Part transcribed: $m"
    fi
    PART_WHY+=("$why")
    if [[ -n "$why" ]]; then
      PART_OK+=(0)
      echo "Part failed: $m ($why)"
      continue
    fi
    PART_OK+=(1)
    parts_ok=$((parts_ok + 1))
    if [[ $SKIP_EXISTING -eq 0 ]] || ! all_named "$named_index" "$m"; then
      parts_new=$((parts_new + 1))
    fi
  done
  if [[ $parts_ok -eq 0 ]]; then
    echo "Error: no part of the meeting ${SID:0:8} could be transcribed." >&2
    exit 1
  fi
  # A retry that adds nothing must not rewrite the transcript or re-alert.
  if [[ $parts_new -eq 0 ]]; then
    echo "Error: no new part of the meeting ${SID:0:8} could be transcribed; its transcript is unchanged." >&2
    exit 1
  fi
  # Numbered among all the meeting's recordings, ready or not.
  n_parts=${#GROUP_IDS[@]}
  pend_list=""
  for i in ${PEND_IDS[@]+"${!PEND_IDS[@]}"}; do
    [[ -z "$pend_list" ]] || pend_list+="; "
    pend_list+="part ${PEND_POS[i]} of $n_parts (starts at $(fmt_clock "${PEND_START[i]}"), session ${PEND_IDS[i]:0:8})"
  done
  if ! {
    if [[ $n_parts -eq 1 ]]; then
      cat "$PIECES_DIR/${PART_IDS[0]}.md"
    else
      if [[ -z "$pend_list" ]]; then
        printf '> **Note:** joined from %d recordings of one meeting.' "$n_parts"
      else
        printf '> **Note:** joined from %d of the %d recordings of one meeting; the note at the end names the rest.' \
          "${#PART_IDS[@]}" "$n_parts"
      fi
      printf ' Timestamps run from the start of the first; speaker numbers restart in each part.\n'
      for i in "${!PART_IDS[@]}"; do
        part_clock=$(fmt_clock "${PART_START[i]}")
        printf '\n## Part %d of %d — starts at %s' "${PART_POS[i]}" "$n_parts" "$part_clock"
        ((PART_POS[i] == 1)) || printf ', after a %d s gap' "${PART_GAP[i]}"
        printf '\n\n'
        if [[ "${PART_OK[i]}" -eq 1 ]]; then
          offset_transcript "$PIECES_DIR/${PART_IDS[i]}.md" "${PART_START[i]}"
        else
          printf '> **Note:** this part (session %s) was not transcribed: %s.\n\n' "${PART_IDS[i]}" "${PART_WHY[i]}"
        fi
      done
      if [[ -n "$pend_list" ]]; then
        printf '\n> **Note:** this transcript may be incomplete. MacWhisper had not finished saving %s when it was written.' "$pend_list"
        pend_when="that part finishes"
        [[ ${#PEND_IDS[@]} -eq 1 ]] || pend_when="those parts finish"
        if [[ $RESTITCH -eq 1 ]]; then
          printf ' It will be updated when %s.\n' "$pend_when"
        else
          printf ' Transcribe the meeting again when %s.\n' "$pend_when"
        fi
      fi
    fi
  } >"$DOC_TMP"; then
    echo "Error: failed to join the transcripts of ${SID:0:8}." >&2
    exit 1
  fi
fi

if [[ ! -s "$DOC_TMP" ]]; then
  echo "Error: mw reported success but produced no transcript at $OUT_DOC" >&2
  exit 1
fi

if ! grep -q "^\*\*Speaker " "$DOC_TMP" 2>/dev/null; then
  echo "Warning: no 'Speaker' labels found in output. Check MacWhisper Settings > speaker detection." >&2
fi

# Last look before writing: a review or a hand edit since the replace decision
# means the replaced doc is kept and this run writes -N.
if [[ $REPLACING -eq 1 ]] && ! still_replaceable; then
  DUP_OF=$(basename "$OUT_DOC")
  take_next_free_name
  REPLACING=0
  echo "Note: $DUP_OF was reviewed or edited while this ran; writing $(basename "$OUT_DOC") instead." >&2
fi

# A possible duplicate says so on its first line, above mw's output.
if [[ -n "$DUP_OF" ]]; then
  note_tmp=$(mktemp "${OUT_DOC}.partial.XXXXXX")
  trap 'rm -f "$DOC_TMP" "$note_tmp"' EXIT
  if ! {
    printf '> **Note:** this transcript may duplicate %s, which already existed when it was written.\n\n' "$DUP_OF"
    cat "$DOC_TMP"
  } >"$note_tmp"; then
    echo "Error: failed to add the duplicate note to the transcript." >&2
    exit 1
  fi
  mv "$note_tmp" "$DOC_TMP"
fi

# --argjson parses its value as JSON and aborts on anything non-numeric, so
# guard the duration rather than letting a surprising DB value abort the run.
META_DURATION="$SDUR"
[[ "$META_DURATION" =~ ^[0-9]+(\.[0-9]+)?$ ]] || META_DURATION=0

# Build BOTH temp files before renaming EITHER into place. The transcript
# and its sidecar are a pair: --mark-reviewed refuses to run without a
# sidecar, so a transcript that landed while the sidecar write failed can
# never be cleaned up, and the meeting has to be transcribed again. Doing
# every fallible step first means the only thing left after them is two
# same-directory renames.
meta_tmp=$(mktemp "${OUT_META}.XXXXXX")
trap 'rm -f "$DOC_TMP" "$meta_tmp"' EXIT
# A stitched sidecar lists the parts it holds, misses and awaits. session_id is
# the first part it holds, so it is always in session_ids.
META_SID="$SID"
META_SOURCE="$SOURCE_FILENAME"
META_IDS='{}'
META_FILES='{}'
if [[ $STITCH -eq 1 ]]; then
  ok_ids=()
  ok_files=()
  missing_ids=()
  for i in "${!PART_IDS[@]}"; do
    if [[ "${PART_OK[i]}" -eq 1 ]]; then
      ok_ids+=("${PART_IDS[i]}")
      ok_files+=("${PART_FILES[i]}")
    else
      missing_ids+=("${PART_IDS[i]}")
    fi
  done
  META_SID="${ok_ids[0]}"
  [[ -z "${ok_files[0]}" ]] || META_SOURCE="${ok_files[0]}"
  META_IDS=$(jq -nc '{session_ids: $ARGS.positional}' --args "${ok_ids[@]}")
  META_FILES=$(jq -nc '{source_files: $ARGS.positional}' --args "${ok_files[@]}")
  if [[ ${#missing_ids[@]} -gt 0 ]]; then
    META_FILES=$(jq -nc --argjson f "$META_FILES" '$f + {missing_session_ids: $ARGS.positional}' --args "${missing_ids[@]}")
  fi
  if [[ ${#PEND_IDS[@]} -gt 0 ]]; then
    META_FILES=$(jq -nc --argjson f "$META_FILES" '$f + {pending_session_ids: $ARGS.positional}' --args ${PEND_IDS[@]+"${PEND_IDS[@]}"})
  fi
fi
META_RESTITCH='{}'
if [[ $RESTITCH -eq 1 ]]; then
  if doc_hash=$(doc_sha256 "$DOC_TMP"); then
    META_RESTITCH=$(jq -nc --arg h "$doc_hash" '{restitchable: true, doc_sha256: $h}')
  else
    echo "Warning: cannot hash the transcript (shasum); a later recording will go to a new transcript." >&2
    META_RESTITCH='{"restitchable": true}'
  fi
fi
META_DUP='{}'
if [[ -n "$DUP_OF" ]]; then
  META_DUP=$(jq -nc --arg f "$DUP_OF" '{may_duplicate: $f}')
fi
if ! jq -n \
  --arg session_id "$META_SID" \
  --arg date "$SESSION_DATE_ONLY" \
  --argjson duration_seconds "$META_DURATION" \
  --arg source_file "$META_SOURCE" \
  --arg output_file "$(basename "$OUT_DOC")" \
  --arg title "$STITLE" \
  --argjson ids "$META_IDS" \
  --argjson files "$META_FILES" \
  --argjson dup "$META_DUP" \
  --argjson restitch "$META_RESTITCH" \
  '{
    session_id: $session_id
  } + $ids + {
    date: $date,
    duration_seconds: $duration_seconds,
    source_file: $source_file
  } + $files + {
    output_file: $output_file,
    title: $title,
    reviewed: false,
    deleted_source: false
  } + $dup + $restitch' >"$meta_tmp"; then
  echo "Error: failed to write metadata sidecar $OUT_META. Transcript not saved." >&2
  exit 1
fi

mv "$DOC_TMP" "$OUT_DOC"
mv "$meta_tmp" "$OUT_META"
trap - EXIT
# Same reasoning as the --mark-reviewed call site above: the transcript and
# sidecar are already safely on disk, so a write_index failure must not
# turn a successful transcription into a nonzero exit -- huddle-watch reads
# that exit status to decide whether to retry, and retrying a transcription
# that already succeeded would silently re-run mw against the same audio.
write_index || echo "Warning: failed to regenerate $OUTPUT_DIR/_index.md" >&2

[[ $REPLACING -eq 0 ]] || echo "Replaced: $OUT_DOC"
echo "Transcript written: $OUT_DOC"
echo "Metadata written:   $OUT_META"
